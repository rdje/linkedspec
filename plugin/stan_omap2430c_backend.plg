old_default {
my ($conf) = @_;
 use Timing::StanOmap2430cBackend;

 print "($conf->{_program}) -I- Loading SETUP & HOLD info..";
 my $setup_hold = TcFlow::GetSH($conf->{_consolidated});

 # SETUP info
 print "($conf->{_program}) -I- Processing SETUP info..\n";
 $conf->{_filteredata} = HUtils::GenericFilter($conf, $setup_hold->{setup}, "filter_sequence");
 $conf->{_stanpaths_lof_workdir} = "$conf->{_workdir}/$$conf{STANLOF_WDIR}";
 system("mkdir -p $conf->{_stanpaths_lof_workdir} $conf->{_workdir}; rm -f $conf->{_stanpaths_lof_workdir}/*");
 
 $conf->{_freqency_detailed}  = 
 $conf->{_stafrequency}       = 
 $conf->{_questionable_paths} = 
 $conf->{_stafrequency_paths} = {};

 HUtils::Recurse($conf->{_filteredata},        [\&Timing::StanOmap2430cBackend::collect_sta_frequency, $conf]);
 HUtils::Recurse($conf->{_stafrequency},       [\&Timing::StanOmap2430cBackend::record_frequency_detail, $conf]);
 
 open(my $dfreq, ">$conf->{_workdir}/drive_freqency_detailed.lof") || die "($conf->{_program}) -E- Can't write open '$conf->{_workdir}/drive_freqency_detailed.lof', ";
 HUtils::Recurse($conf->{_freqency_detailed},  [\&Timing::StanOmap2430cBackend::write_frequency_detail, $conf, $dfreq]);
 close($dfreq);
 HUtils::Recurse($conf->{_stafrequency_paths}, [\&Timing::StanOmap2430cBackend::write_frequency_detail_paths, $conf]);
 HUtils::WRecurse($conf->{_filteredata},       [\&Timing::StanOmap2430cBackend::filter_port_timing_paths, $conf]);

 # HOLD info
 print "($conf->{_program}) -I- Processing HOLD info..\n";
 my $filteredata_hold = HUtils::GenericFilter($conf, $setup_hold->{hold}, "filter_sequence");
 HUtils::WRecurse($filteredata_hold,   [\&Timing::StanOmap2430cBackend::filter_port_timing_paths, $conf]);
 
# print "($conf->{_program}) -I- Generating DM DATA..\n";
# LinkedSpec::get_plugin('setup_hold_tmax_tmin')->($conf, $conf->{_filteredata}, $filteredata_hold);

# Timing::StanOmap2430cBackend::write_frequency_summary($conf);
# Timing::StanOmap2430cBackend::write_potential_fp($conf);
# Timing::StanOmap2430cBackend::write_questionable_paths($conf);
# Timing::StanOmap2430cBackend::write_no_path_check($conf);
}

dm_measures {
my ($conf) = @_;
 use Timing::StanOmap2430cBackend;

 print "($conf->{_program}) -I- DM Measures..\n";
 
 system("mkdir -p $conf->{_workdir};");

 my $sh        = TcFlow::GetSH($conf->{_consolidated});
 my $merged_sh = $sh->{setup};
 push @$merged_sh, @{$sh->{hold}};

 my $filteredata_sh  = HUtils::GenericFilter($conf, $merged_sh, ($conf->{variant} ? "tck_" : "")."filter_sequence");

 my $merged_clock_sh;
 my $filteredata_clock_sh;

 HUtils::WRecurse($filteredata_sh, sub {my ($info, $a2d) = @_;
   my ($mode, $tck_iomode, $corner, $tck_timing_segments) = @$info;
   my ($tseg_prefix) = $tck_timing_segments =~ /(\w+)/;
   my $right_index   = $conf->{_indexes}{$conf->{'what-to-look'}{$tck_timing_segments}};
   my @minmax        =  sort {$a <=> $b} map {$$_[$right_index]} @$a2d;
   my $sorted        = [sort {$b->[$right_index] <=> $a->[$right_index]} @$a2d];

   {paths=>$sorted, min=>shift(@minmax), max=>pop(@minmax)}
 });

 Timing::StanOmap2430cBackend::write_tck_delays($conf, $filteredata_sh);
}

potential_fp {
use Timing::StanOmap2430cBackend;
Timing::StanOmap2430cBackend::write_potential_fp(@_)
}

questionable_paths {
use Timing::StanOmap2430cBackend;
Timing::StanOmap2430cBackend::write_questionable_paths(@_)
}

freqency_summary {
use Timing::StanOmap2430cBackend;
Timing::StanOmap2430cBackend::write_frequency_summary(@_)
}
