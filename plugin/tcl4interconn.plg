tcl4interconn {
my ($qconf, $groups, $port, $tcl4interconn) = @_;
 use QC::TclInterconn;

 return QC::TclInterconn::append_interconnect_tcl($qconf, $groups, $port, $tcl4interconn);
}


tcl4fanx {
my ($qconf) = @_;
 use QC::TclInterconn;

 return QC::TclInterconn::load_fanx($qconf);
}


get_fanxinfo {
my ($qconf, $port) = @_;
 use QC::TclInterconn;

 return QC::TclInterconn::fanx_info($qconf, $port);
}
