http {
 use Sys::Hostname;
 use Plugin::HTTP;

 Global->set ('cgi') = HUtils::Conf(PathSearch->go('cgi'));

 Plugin::HTTP::set_http_hostport (($_[0]{_host} || hostname).Global->http_hostail, $_[0]{_port});

 print "\n";

 foreach (@{$_[0]{_argv}}) {
  next unless -f;

  print " ", Plugin::HTTP::httplink ($_), "\n";
 }

 print "\n";
}
