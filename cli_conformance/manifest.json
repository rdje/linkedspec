    {
      "id": "usage_missing_input_selector",
      "family": "usage",
      "args": ["--inline-spec", "Top:: /x/"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "choose exactly one input option: --input or --input-file"}},
        "files": []
      }
    },
    {
      "id": "usage_source_selector_conflict",
      "family": "usage",
      "args": ["--inline-spec", "Top:: /x/", "--spec", "Lispish", "--input", "x"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "choose exactly one source option: --spec, --spec-file, or --inline-spec"}},
        "files": []
