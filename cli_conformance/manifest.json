{
  "schema_version": 1,
  "suite": "linkedspec-primary-cli",
  "cases": [
    {
      "id": "help",
      "family": "help",
      "args": ["--help"],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {
          "file": "cases/help/stdout.txt"
        },
        "stderr": {
          "text": ""
        },
        "files": []
      }
    },
    {
      "id": "help_short",
      "family": "help",
      "args": ["-h"],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"file": "cases/help/stdout.txt"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "usage_no_arguments",
      "family": "usage",
      "args": [],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "choose exactly one source option: --spec, --spec-file, or --inline-spec"}},
        "files": []
      }
    },
    {
      "id": "usage_status_subcommand",
      "family": "usage",
      "args": ["status"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "unexpected positional argument 'status'"}},
        "files": []
      }
    },
    {
      "id": "usage_corpus_subcommand",
      "family": "usage",
      "args": ["corpus"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "unexpected positional argument 'corpus'"}},
        "files": []
      }
    },
    {
      "id": "usage_trailing_positional",
