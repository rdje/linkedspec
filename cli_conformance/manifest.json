      "id": "usage_invalid_parse_mode",
      "family": "usage",
      "args": ["--inline-spec", "Top:: /x/", "--input", "x", "--parse-mode", "scan"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "--parse-mode must be 'seek' or 'consume'"}},
        "files": []
      }
    },
    {
      "id": "usage_invalid_trace_level",
      "family": "usage",
      "args": ["--inline-spec", "Top:: /x/", "--input", "x", "--trace", "loud"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "--trace has an unsupported level 'loud'"}},
        "files": []
      }
    },
    {
      "id": "usage_invalid_trace_mode",
      "family": "usage",
      "args": ["--inline-spec", "Top:: /x/", "--input", "x", "--trace-mode", "both"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "--trace-mode must be 'stdout', 'route', or 'mirror'"}},
        "files": []
      }
    },
    {
      "id": "usage_multiple_errors",
      "family": "usage",
      "args": ["one", "--UNKNOWN", "two"],
      "files": [],
      "expect": {
        "exit": 2,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/usage/stderr.txt", "variables": {"ERROR": "unexpected positional argument 'one'; unknown option '--UNKNOWN'; unexpected positional argument 'two'"}},
        "files": []
      }
    },
    {
      "id": "success_named_source_literal_input",
      "family": "success",
      "args": ["--spec", "Lispish", "--input", "(hello world)"],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"text": "[\"hello\",[\"world\"]]\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_file_source_file_input_nested_json",
      "family": "success",
      "args": ["--spec-file", "nested.spec", "--input-file", "input.txt"],
      "files": [
        {"source": "cases/success/nested.spec", "path": "nested.spec"},
        {"source": "cases/success/input.txt", "path": "input.txt"}
      ],
      "expect": {
        "exit": 0,
        "stdout": {"text": "{\"a\":{\"b\":2,\"d\":4},\"z\":0}\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_inline_source_literal_input",
      "family": "success",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(\"inline\") }\n\nDone::\n /x/\n",
        "--input",
        "x"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"text": "\"inline\"\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_explicit_top_rule",
      "family": "success",
      "args": [
        "--inline-spec",
        "Top::\n /a/ -> Done { return(\"top\") }\n\nAlternate:\n /b/ -> Done { return(\"alternate\") }\n\nDone::\n /[ab]/\n",
        "--input",
        "b",
        "--top-rule",
        "Alternate"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"text": "\"alternate\"\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_seek_mode",
      "family": "success",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(\"seek\") }\n\nDone::\n /x/\n",
        "--input",
        "prefix x",
        "--parse-mode",
        "seek"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"text": "\"seek\"\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_consume_mode",
      "family": "success",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(\"consume\") }\n\nDone::\n /x/\n",
        "--input",
        "x",
        "--parse-mode",
        "consume"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {"text": "\"consume\"\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "success_input_file_exact_bytes",
      "family": "success",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(input_text()) }\n\nDone::\n /x/\n",
        "--input-file",
        "input.txt"
      ],
      "files": [
        {"source": "cases/success/input.txt", "path": "input.txt"}
      ],
      "expect": {
        "exit": 0,
        "stdout": {"text": "\"x\\n\"\n"},
        "stderr": {"text": ""},
        "files": []
      }
    },
    {
      "id": "failure_compile_precedes_input_load",
      "family": "failure",
      "args": ["--inline-spec", "not a spec", "--input-file", "missing-input.txt"],
      "files": [],
      "expect": {
        "exit": 1,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/failure/stderr.txt", "variables": {"ERROR": "parser compilation failed"}},
        "files": []
      }
    },
    {
      "id": "failure_missing_spec_file",
      "family": "failure",
      "args": ["--spec-file", "missing.spec", "--input", "x"],
      "files": [],
      "expect": {
        "exit": 1,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/failure/stderr.txt", "variables": {"ERROR": "parser compilation failed"}},
        "files": []
      }
    },
    {
      "id": "failure_input_load",
      "family": "failure",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(\"ok\") }\n\nDone::\n /x/\n",
        "--input-file",
        "missing-input.txt"
      ],
      "files": [],
      "expect": {
        "exit": 1,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/failure/stderr.txt", "variables": {"ERROR": "input load failed"}},
        "files": []
      }
    },
    {
      "id": "failure_invocation_missing_top_rule",
      "family": "failure",
      "args": [
        "--inline-spec",
        "Top::\n /x/ -> Done { return(\"ok\") }\n\nDone::\n /x/\n",
        "--input",
        "x",
        "--top-rule",
        "Missing"
      ],
      "files": [],
      "expect": {
        "exit": 1,
        "stdout": {"text": ""},
        "stderr": {"file": "cases/failure/stderr.txt", "variables": {"ERROR": "parser invocation failed"}},
