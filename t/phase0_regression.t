    my $orig_run_get_parser = \&LinkedSpec::ParserFactory::run_get_parser;

    my ($ok_run, $parser, $ast, $err) = (0, undef, undef, '');
    my ($saw_hashref, $captured_option);
    $ok_run = eval {
        no warnings 'redefine';
