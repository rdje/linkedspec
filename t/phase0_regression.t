        LinkedSpec::call_spec_handler_subst('Top', 'return(hash("content", coalesce(scalaref(retv, {content}), scalar(IMATCH), "UNKNOWN"), "parts", coalesce(scalaref(retv, {parts}), array("empty"))))'),
