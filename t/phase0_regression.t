            if defined($owner_pkg) && $owner_pkg eq 'LinkedSpec::BootstrapSpec'
            && defined($target_pkg) && $target_pkg eq 'LinkedSpec::BootstrapSpec::Core'
            && defined($subname) && $subname eq 'build_bootstrap_spec';
