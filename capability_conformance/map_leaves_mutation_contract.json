{
  "format": 1,
  "contract_id": "linkedspec-map-leaves-mutation-v1",
  "status": "future-neutral-contract; no backend behavior admitted",
  "policy": {
    "sole_bang_method": "map_leaves! is the only v1 bang-suffixed method and the suffix is syntax on that receiver method token, not an identifier character or a general bang permission",
    "addressable_receiver": "the receiver is one resolved bare non-reserved uniform-binding identity; literals, temporaries, helper results, properties, nested access, rules, and runtime pseudo-bindings are not addressable receivers",
    "snapshot": "receiver lookup validates an existing harray or array and deep-copies it before callbacks; traversal and rebuilding use only that isolated original-shape snapshot",
    "traversal": "the starting root kind selects recursion for the whole call: harray roots recurse only through harrays in ascending key order and array roots recurse only through arrays in zero-based index order",
    "callback_frame": "each leaf callback receives detached scoped value, path, depth, and root-kind selector key or index; path is a fresh complete receiver-root-relative copy for every callback",
    "callback_result": "the callback result is detached into the rebuilt leaf; assigning or mutating scoped value does not update the receiver, and a replacement aggregate is not revisited during the same call",
    "atomic_commit": "callback code cannot modify the receiver binding, root kind, or original traversal topology; complete callback success atomically publishes only the rebuilt leaf values through one implementation-owned copy-on-write root swap",
    "reentrancy": "while callbacks execute, every direct or helper-mediated write through the same resolved receiver binding identity is rejected before that attempted write; a shadow binding with the same spelling and unrelated binding identities remain independent",
    "failure_effects": "receiver validation, callback, or re-entrant failure leaves the receiver unchanged while already-completed ordinary effects on unrelated bindings retain normal semantics",
    "result": "successful leaf publication returns a detached updated-root value; statement-position use may discard that value without suppressing the approved leaf updates",
    "continuation": "ordinary fluent continuation starts only after the bang call commits and consumes the detached returned value; a later continuation failure does not roll back the completed bang commit",
    "detachment": "the invocation snapshot, committed receiver, returned root, callback values and paths, callback aggregate results, and authored initial aggregates do not share writable host aliases",
    "nonbang": "map_leaves remains the unchanged non-mutating twin and cannot obtain receiver mutation through callback value or result aliases",
    "current_boundary": "this contract admits no current backend behavior; Perl, Rust, Dart, Julia, and Lua remain bang-syntax-invalid until separately owned implementation leaves"
  },
  "syntax": {
    "identifier_pattern": "[A-Za-z_][A-Za-z0-9_]*",
    "surface": "IDENTIFIER.map_leaves!() { ACTION_BLOCK } CONTINUATION*",
    "method_token": "map_leaves!",
    "method_identity": "map_leaves",
    "bang_count": 1,
    "parenthesized_arguments": 0,
    "callback": "one immediate trailing ActionIR block is required",
    "receiver": "one bare addressable uniform-binding identifier resolved at runtime",
    "continuation": "zero or more existing non-bang fluent calls parsed as ordinary ActionIR after the mutation call",
    "suffix_spacing": "the exclamation mark immediately follows map_leaves; ordinary insignificant whitespace remains allowed around the dot, empty parentheses, callback block, and continuation",
    "reserved_receiver_names": ["CAPTURE", "IINDEX", "IMATCH", "IMATCH_HASH", "IMATCH_LIST", "IPOS", "LINDEX", "LMATCH", "LMATCH_HASH", "LMATCH_LIST", "LSPOS", "STRING", "descr", "false", "info", "minfo", "null", "retv", "true", "undef"],
    "excluded_methods": ["walk_leaves!", "reduce_leaves!", "map!"],
    "excluded_forms": ["function_form", "literal_receiver", "temporary_receiver", "helper_result_receiver", "property_receiver", "nested_access_receiver", "rule_receiver", "runtime_pseudo_binding", "arbitrary_bang_identifier", "bang_continuation"]
  },
  "ast": {
    "node_kind": "receiver_mutation_chain",
    "fields": ["kind", "source", "source_span", "receiver", "mutation", "continuation"],
    "receiver_kind": "binding_reference",
    "receiver_fields": ["kind", "name", "source", "source_span"],
    "mutation_kind": "receiver_mutation_call",
    "mutation_fields": ["kind", "method", "source_method", "source", "source_span", "method_span", "args_span", "callback"],
    "method": "map_leaves",
    "source_method": "map_leaves!",
    "callback_kind": "block_value",
    "callback_fields": ["kind", "source", "source_span", "body"],
    "body_kind": "action_block",
    "body_fields": ["kind", "source", "source_span"],
    "continuation_kind": "fluent_call",
    "continuation_fields": ["kind", "method", "source_method", "source", "source_span", "args_source", "args_span"],
    "source_span": "half-open Unicode-scalar offsets over authored source; the chain spans the complete expression and every child span retains authored coordinates",
    "callback_body": "the body is parsed by the existing typed ActionIR block parser without a bang-specific sublanguage"
  },
  "diagnostics": {
