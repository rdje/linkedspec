      "fields": ["code", "operation", "binding", "method", "attempt", "source_span", "message"]
    },
    "callback_failure": "propagate the callback diagnostic unchanged and without a map_leaves_mutation wrapper",
    "continuation_failure": "propagate the continuation diagnostic unchanged after preserving the completed receiver commit",
    "operation": "map_leaves_mutation",
    "method": "map_leaves",
    "expected_receiver_kinds": ["harray", "array"],
    "source_span": "a typed authored half-open Unicode-scalar span; receiver failures point to the receiver and re-entrant failures point to the attempted mutation target or helper call",
    "precedence": ["syntax_validation", "receiver_resolution", "receiver_kind_validation", "callback_or_reentrant_failure", "commit", "continuation"]
  },
