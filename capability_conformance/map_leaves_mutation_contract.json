      "stage": "action_parse",
      "codes": ["bang_method_function_form_invalid", "bang_method_unknown", "bang_method_suffix_invalid", "receiver_mutation_receiver_not_addressable", "receiver_mutation_receiver_reserved", "map_leaves_mutation_arguments_invalid", "map_leaves_mutation_callback_missing", "receiver_mutation_continuation_bang_invalid"],
      "fields": ["code", "stage", "source_span", "message"]
