    {
      "id": "hash_sorted_frames_and_cross_kind_leaf",
      "source": "tree.map_leaves!() { return(value) }",
      "binding": "tree",
      "initial_bindings": {"tree": {"b": {"z": "B"}, "a": "A", "arr": [1, 2]}},
      "callback_steps": [
        {"frame": {"value": "A", "key": "a", "path": ["a"], "depth": 1}, "result": "a@1=A"},
        {"frame": {"value": [1, 2], "key": "arr", "path": ["arr"], "depth": 1}, "result": ["array-leaf"]},
        {"frame": {"value": "B", "key": "z", "path": ["b", "z"], "depth": 2}, "result": "z@2=B"}
      ],
      "expected_bindings": {"tree": {"a": "a@1=A", "arr": ["array-leaf"], "b": {"z": "z@2=B"}}},
      "expected_result": {"a": "a@1=A", "arr": ["array-leaf"], "b": {"z": "z@2=B"}},
      "expected_effects": ["callback:a", "callback:arr", "callback:b/z", "commit:tree"]
    },
