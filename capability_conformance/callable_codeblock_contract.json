{
  "format": 1,
  "contract_id": "linkedspec-callable-codeblock-v1",
  "policy": {
    "construction": "{|params| body } constructs deferred typed codeblock data and does not execute body",
    "invocation": "a bound codeblock variable is invoked as cb(args) with positional once-only left-to-right evaluation",
    "context": "nonparameter reads and mutations use caller stores at invocation time; construction captures no environment",
    "parameters": "fixed and final-rest values are recursively copied into temporary bindings and prior same-name bindings are restored",
    "results": "return is block-local; otherwise the final expression yields; results may chain or be discarded",
    "resolution": "governed helpers controls and registered user functions precede same-named codeblock variables",
    "failures": "keyword calls non-callable values unknown names arity mismatches and recursion diagnose without host fallback",
    "trailing_blocks": "callable signatures govern attached and contextual final-codeblock normalization; with remains an ordinary helper",
    "closures": "lexical capture by reference or snapshot is excluded from version 1"
  },
  "syntax": {
    "opener": "{|",
    "opener_whitespace": false,
    "signature_closer": "|",
    "literal_closer": "}",
    "zero_parameter_form": "{|| body }",
    "parameter_separator": ",",
    "rest_form": "...IDENTIFIER",
    "rest_position": "final"
  },
  "final_codeblock_parameter_declaration": {
    "value_kind": "codeblock",
    "source": "callback: codeblock",
    "parameter_name": "callback",
    "position": "final",
    "callback_signature_owner": "codeblock_value",
    "contextual_block_invocation": "zero positional arguments with dynamic caller context",
    "rest_parameter_after": false,
    "invalid": [
      {"id": "non_final", "source": "callback: codeblock, tail", "expected_code": "codeblock_parameter_must_be_final"},
      {"id": "argument_list", "source": "callback: codeblock(item)", "expected_code": "codeblock_declaration_has_no_argument_list"},
      {"id": "missing_name", "source": ": codeblock", "expected_code": "invalid_codeblock_parameter_name"},
      {"id": "unknown_type", "source": "callback: closure", "expected_code": "unknown_parameter_type"}
    ]
  },
  "brace_classification": [
    {"id": "empty_harray", "source": "{}", "expected_kind": "harray_literal"},
    {"id": "keyed_harray", "source": "{ \"kind\" : value }", "expected_kind": "harray_literal"},
    {"id": "dynamic_key_harray", "source": "{ key : value }", "expected_kind": "harray_literal"},
    {"id": "immediate_block", "source": "{ state = \"now\"; state }", "expected_kind": "block_value"},
    {"id": "zero_arg_codeblock", "source": "{|| return(state) }", "expected_kind": "codeblock_literal"},
    {"id": "fixed_codeblock", "source": "{|left, right| return(cat(left, right)) }", "expected_kind": "codeblock_literal"},
    {"id": "rest_codeblock", "source": "{|prefix, ...items| return(items) }", "expected_kind": "codeblock_literal"}
  ],
  "ast_schema": {
    "kind": "codeblock_literal",
    "version": 1,
    "fields": [
      "kind",
      "version",
      "signature",
      "body_source",
      "body_ast",
      "source_text",
      "source_span",
      "body_span"
    ],
    "signature_contract": "capability_conformance/callable_signature_contract.json:signature_schema",
    "captured_environment_field": null
  },
  "resolution_precedence": [
    "control",
    "helper",
    "registered_user_function",
    "bound_codeblock_variable",
    "bound_non_codeblock_diagnostic",
    "unknown_call_diagnostic"
  ],
  "literals": [
    {
      "id": "join_fixed",
      "variable": "joiner",
      "signature_source": "left, right",
      "source": "{|left, right| return(cat(left, right)) }",
      "body_source": " return(cat(left, right)) ",
      "behavior": "join_fixed"
    },
    {
      "id": "read_dynamic",
      "variable": "reader",
      "signature_source": "",
      "source": "{|| return(state) }",
      "body_source": " return(state) ",
      "behavior": "read_dynamic"
    },
    {
      "id": "mutate_dynamic",
      "variable": "append_state",
      "signature_source": "value",
      "source": "{|value| state = cat(state, value); return(state) }",
      "body_source": " state = cat(state, value); return(state) ",
      "behavior": "mutate_dynamic"
    },
    {
      "id": "restore_parameter",
      "variable": "decorate",
      "signature_source": "value",
      "source": "{|value| value = cat(value, \"!\"); return(value) }",
      "body_source": " value = cat(value, \"!\"); return(value) ",
      "behavior": "restore_parameter"
    },
    {
      "id": "collect_rest",
      "variable": "collector",
      "signature_source": "prefix, ...items",
      "source": "{|prefix, ...items| return({ \"prefix\" : prefix, \"items\" : items }) }",
      "body_source": " return({ \"prefix\" : prefix, \"items\" : items }) ",
      "behavior": "collect_rest"
    },
    {
      "id": "early_return",
      "variable": "stop_early",
      "signature_source": "",
      "source": "{|| return(\"done\"); state = \"wrong\" }",
      "body_source": " return(\"done\"); state = \"wrong\" ",
      "behavior": "early_return"
    },
    {
      "id": "shadow_static",
      "variable": "cat",
      "signature_source": "left, right",
      "source": "{|left, right| return(\"shadow\") }",
      "body_source": " return(\"shadow\") ",
      "behavior": "shadow_static"
    }
  ],
  "call_cases": [
    {"id": "construction_is_deferred", "literal": "mutate_dynamic", "initial_state": {"state": "before"}, "operation": "construct", "expected": {"state": "before"}},
    {"id": "fixed_exact", "literal": "join_fixed", "initial_state": {}, "arguments": [{"kind": "positional", "value": "a"}, {"kind": "positional", "value": "b"}], "expected": {"result": "ab", "state": {}}},
    {"id": "dynamic_read_uses_call_time_state", "literal": "read_dynamic", "construction_state": {"state": "initial"}, "initial_state": {"state": "later"}, "arguments": [], "expected": {"result": "later", "state": {"state": "later"}}},
    {"id": "nonparameter_mutation_persists", "literal": "mutate_dynamic", "initial_state": {"state": ""}, "calls": [[{"kind": "positional", "value": "a"}], [{"kind": "positional", "value": "b"}]], "expected": {"results": ["a", "ab"], "state": {"state": "ab"}}},
    {"id": "parameter_binding_restores", "literal": "restore_parameter", "initial_state": {"value": "outer"}, "arguments": [{"kind": "positional", "value": "inner"}], "expected": {"result": "inner!", "state": {"value": "outer"}}},
    {"id": "rest_empty", "literal": "collect_rest", "initial_state": {}, "arguments": [{"kind": "positional", "value": "p"}], "expected": {"result": {"prefix": "p", "items": []}, "state": {}}},
    {"id": "rest_mixed", "literal": "collect_rest", "initial_state": {}, "arguments": [{"kind": "positional", "value": "p"}, {"kind": "positional", "value": 1}, {"kind": "positional", "value": [2]}, {"kind": "positional", "value": {"k": 3}}, {"kind": "positional", "value": false}, {"kind": "positional", "value": null}], "expected": {"result": {"prefix": "p", "items": [1, [2], {"k": 3}, false, null]}, "state": {}}},
    {"id": "rest_result_receiver_chain", "literal": "collect_rest", "initial_state": {}, "arguments": [{"kind": "positional", "value": "p"}, {"kind": "positional", "value": "a"}, {"kind": "positional", "value": "b"}], "result_chain": "items.length", "expected": {"result": 2, "state": {}}},
    {"id": "block_local_return", "literal": "early_return", "initial_state": {"state": "right"}, "arguments": [], "expected": {"result": "done", "state": {"state": "right"}}},
    {"id": "standalone_discard_keeps_effects", "literal": "mutate_dynamic", "initial_state": {"state": ""}, "arguments": [{"kind": "positional", "value": "x"}], "discard_result": true, "expected": {"result": null, "state": {"state": "x"}}},
    {"id": "static_name_precedence", "literal": "shadow_static", "initial_state": {}, "callee": "cat", "arguments": [{"kind": "positional", "value": "a"}, {"kind": "positional", "value": "b"}], "expected": {"result": "ab", "state": {}}}
  ],
  "invalid_literal_cases": [
    {"id": "whitespace_after_brace", "source": "{ |value| return(value) }", "expected_code": "invalid_codeblock_opener"},
    {"id": "missing_signature_closer", "source": "{|value return(value) }", "expected_code": "missing_codeblock_signature_closer"},
    {"id": "empty_parameter", "source": "{|left, , right| return(left) }", "expected_code": "invalid_parameter"},
    {"id": "invalid_parameter", "source": "{|1value| return(1) }", "expected_code": "invalid_parameter"},
    {"id": "rest_not_final", "source": "{|...items, tail| return(items) }", "expected_code": "rest_parameter_must_be_final"},
    {"id": "missing_rest_name", "source": "{|...| return(undef) }", "expected_code": "invalid_rest_parameter"},
    {"id": "rest_marker_name_whitespace", "source": "{|... items| return(items) }", "expected_code": "invalid_rest_parameter"},
    {"id": "duplicate_parameter", "source": "{|item, ...item| return(item) }", "expected_code": "duplicate_parameter"},
    {"id": "reserved_parameter", "source": "{|return| return(undef) }", "expected_code": "reserved_parameter"}
  ],
  "invalid_call_cases": [
    {"id": "fixed_missing", "literal": "join_fixed", "arguments": [{"kind": "positional", "value": "a"}], "expected_error": {"code": "codeblock_arity_mismatch", "expected": "exactly 2", "got": 1}},
    {"id": "fixed_extra", "literal": "join_fixed", "arguments": [{"kind": "positional", "value": "a"}, {"kind": "positional", "value": "b"}, {"kind": "positional", "value": "c"}], "expected_error": {"code": "codeblock_arity_mismatch", "expected": "exactly 2", "got": 3}},
    {"id": "rest_missing_fixed", "literal": "collect_rest", "arguments": [], "expected_error": {"code": "codeblock_arity_mismatch", "expected": "at least 1", "got": 0}},
    {"id": "keyword_argument", "literal": "restore_parameter", "arguments": [{"kind": "keyword", "name": "value", "value": "x"}], "expected_error": {"code": "codeblock_keyword_arguments_unsupported", "expected": "positional arguments", "got": 1}},
    {"id": "bound_non_codeblock", "binding": "text", "value": "not callable", "arguments": [], "expected_error": {"code": "value_not_callable", "value_kind": "scalar"}},
    {"id": "unknown_call", "binding": "missing", "arguments": [], "expected_error": {"code": "unknown_helper", "name": "missing"}},
    {"id": "direct_recursion", "literal": "read_dynamic", "active_codeblocks": ["reader"], "arguments": [], "expected_error": {"code": "codeblock_recursion_unsupported", "cycle": ["reader", "reader"]}}
  ],
  "contextual_final_block_cases": [
    {"id": "helper_attached", "surface": "helper", "source": "with(\"x\") { return(value) }", "parameter_declaration": "callback: codeblock", "canonical_kind": "call", "final_argument_kind": "codeblock_argument"},
    {"id": "helper_parenthesized", "surface": "helper", "source": "with(\"x\", { return(value) })", "parameter_declaration": "callback: codeblock", "canonical_kind": "call", "final_argument_kind": "codeblock_argument"},
    {"id": "user_function_attached", "surface": "user_function", "source": "apply(\"x\") { return(value) }", "parameter_declaration": "callback: codeblock", "canonical_kind": "call", "final_argument_kind": "codeblock_argument"},
    {"id": "user_function_parenthesized", "surface": "user_function", "source": "apply(\"x\", { return(value) })", "parameter_declaration": "callback: codeblock", "canonical_kind": "call", "final_argument_kind": "codeblock_argument"},
    {"id": "receiver_attached", "surface": "receiver", "source": "\"x\".with() { return(value) }", "parameter_declaration": "callback: codeblock", "canonical_kind": "fluent_chain", "final_argument_kind": "codeblock_argument"},
    {"id": "receiver_parenthesized", "surface": "receiver", "source": "\"x\".with({ return(value) })", "parameter_declaration": "callback: codeblock", "canonical_kind": "fluent_chain", "final_argument_kind": "codeblock_argument"},
    {"id": "explicit_literal", "surface": "helper", "source": "with(\"x\", {|value| return(value) })", "parameter_declaration": "callback: codeblock", "canonical_kind": "call", "final_argument_kind": "codeblock_literal"},
    {"id": "harray_not_promoted", "surface": "helper", "source": "with(\"x\", { \"value\" : value })", "parameter_declaration": "callback: codeblock", "expected_error": "final_argument_not_codeblock"}
  ],
