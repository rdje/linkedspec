    "commit": "invalidate first, preserve recognized cursor, boundary, and mark state, then return the staged payload; commit after a miss returns undef",
    "rollback": "restore the owning invocation cursor, anonymous boundary, and named-mark snapshot, discard the staged payload, then invalidate without an authored value",
    "terminal": "every token has exactly one attempt and exactly one terminal on every path; a second terminal is invalid-token reuse",
