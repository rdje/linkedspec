  "terminology": {
    "structural_slot": "a typed target-rule plus zero-based regex-index identity, optionally carrying a future stable slot id",
    "ordered_selection": "a sequence step whose required structural slot is already known",
    "choice_selection": "a step where two or more authored structural slots are concurrently eligible",
    "duplicate_pattern": "two distinct structural slots whose regex pattern text is equal"
  },
  "identity": {
    "duplicate_pattern_text_is_legal": true,
    "required_fields": ["target_rule", "regex_index"],
    "future_optional_field": "target_slot_id",
    "numeric_and_named_selectors_resolve_to_same_identity": true,
    "identity_recovery_forbidden": ["regex_text", "source_adjacency", "capture_text", "alternation_branch_guess"],
