  },
  "selection": {
    "ordered": {
      "algorithm": "match_only_the_required_structural_slot_and_report_that_same_identity",
      "cursor_policy": "the entered rule family still determines consume or seek",
      "mismatch_policy": "a matcher result for another slot is an invariant failure, not an ordinary miss",
      "repetition": "reset to the first required sequence slot for each accepted iteration"
    },
    "choice": {
      "algorithm": "evaluate_every_eligible_structural_slot",
      "primary_priority": "earliest_match_start",
      "tie_break": "lowest_authored_order",
      "duplicate_tie_result": "first_authored_slot"
    }
  },
