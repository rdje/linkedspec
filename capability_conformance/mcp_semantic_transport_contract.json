  "tools": [
    {
      "name": "linkedspec_semantic_capabilities",
      "title": "Inspect LinkedSpec semantic capabilities",
      "description": "Return the effective read-only semantic model, source-detail, paging, and budget capabilities for one caller-registered immutable LinkedSpec semantic index.",
      "input_schema_def": "capabilitiesArguments",
      "output_schema_def": "semanticQueryResponse",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    },
    {
      "name": "linkedspec_semantic_query",
      "title": "Query LinkedSpec semantics",
      "description": "Run one bounded read-only linkedspec-semantic-query-v1 request against a caller-registered immutable LinkedSpec semantic index.",
      "input_schema_def": "semanticQueryArguments",
      "output_schema_def": "semanticQueryResponse",
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      }
    }
  ],
  "request_limits": {
    "line_bytes_excluding_delimiter": 1048576,
    "json_nesting_depth": 64,
    "string_id_utf8_bytes": 128,
    "integer_id_min": -9007199254740991,
    "integer_id_max": 9007199254740991,
    "accepted_delimiters": ["LF", "CRLF"],
    "emitted_delimiter": "LF",
    "reject_bom": true,
    "reject_duplicate_keys": true,
    "reject_batches": true,
    "reject_non_object": true
  },
  "request_metadata": {
    "required": [
