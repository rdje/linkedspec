      "io.modelcontextprotocol/protocolVersion"
    ],
    "optional": ["io.modelcontextprotocol/clientInfo"],
    "protocol_version": "2026-07-28",
    "client_info_is_authorization": false,
    "additional_valid_metadata": "ignored_without_behavior_change"
  },
  "handle_registry": {
    "registration_surface": "native_host_api_only",
    "entropy_bits": 256,
    "encoding": "unpadded_base64url",
    "encoded_characters": 43,
    "default_lifetime_ms": 900000,
    "maximum_lifetime_ms": 86400000,
    "sliding_expiry": false,
    "default_maximum_live_handles": 1024,
    "prune_expired_before_capacity_failure": true,
    "host_may_revoke": true,
    "clear_and_release_on_shutdown": true,
    "deterministic_rng_and_clock": "explicit_test_dependencies_only",
    "authorization_checks": [
      "authorization_context",
      "revocation",
      "monotonic_absolute_expiry",
      "deployment_policy"
    ],
    "indistinguishable_states": ["unknown", "expired", "revoked", "unauthorized"]
  },
  "deployment_policy": {
    "mode": "lowering_only",
    "components": [
      "source_detail_ceiling",
      "page_max",
      "budget_maxima.max_records",
      "budget_maxima.max_relations",
      "budget_maxima.max_depth"
    ],
    "effective_maximum": "component_wise_minimum_native_server_registration",
    "effective_default": "native_default_capped_by_effective_maximum",
    "pre_dispatch_enforcement": "explicit_overlay_component_presence_only",
    "unsupplied_component": "native_dispatch_and_native_portable_response",
    "partial_overlay": "independent_per_component",
    "capabilities": "native_first_then_schema_preserving_policy_field_projection",
    "allowed_query": "unchanged_native_dispatch_and_response",
    "denied_query": "tool_execution_error_before_native_dispatch",
    "silent_request_lowering": false,
    "semantic_response_synthesis": false
  },
  "tool_execution_errors": [
    {
      "id": "handle_unavailable",
      "code": "linkedspec_mcp_handle_unavailable",
      "message": "No current authorized semantic index is available for this handle.",
      "covers": ["unknown", "expired", "revoked", "unauthorized"]
    },
    {
      "id": "policy_denied",
      "code": "linkedspec_mcp_policy_denied",
      "message": "The semantic query exceeds the deployment policy for this handle.",
      "covers": ["source_detail", "content_digest", "page_limit", "record_budget", "relation_budget", "depth_budget"]
    }
