          {"kind": "path_segment", "source": "0", "source_span": {"start": 21, "end": 22}, "expression": {"kind": "integer_literal", "source": "0", "source_span": {"start": 21, "end": 22}}},
          {"kind": "path_segment", "source": "\"title\"", "source_span": {"start": 24, "end": 31}, "expression": {"kind": "string_literal", "source": "\"title\"", "source_span": {"start": 24, "end": 31}}}
