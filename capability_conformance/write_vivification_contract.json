      "source": "document[mutate_document_then_key()] = \"done\"",
      "binding": "document",
      "initial_binding": {"present": false},
      "segments": [{"source": "mutate_document_then_key()", "kind": "string", "value": "value", "same_binding_after": {"seed": 1}}],
      "rhs": {"source": "\"done\"", "value": "done"},
      "expected_effects": ["segment:0", "rhs"],
      "expected_binding": {"seed": 1, "value": "done"},
      "expected_result": {"seed": 1, "value": "done"}
    }
  ],
