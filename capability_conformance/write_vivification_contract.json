        "segments": [
          {"kind": "path_segment", "source": "\"title\"", "source_span": {"start": 9, "end": 16}, "expression": {"kind": "string_literal", "source": "\"title\"", "source_span": {"start": 9, "end": 16}}}
        ],
        "value": {"kind": "identifier", "source": "title", "source_span": {"start": 20, "end": 25}}
      }
    },
    {
