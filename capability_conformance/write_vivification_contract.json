      "source": "document[\"0\"] = value",
      "expected_ast": {
        "kind": "assign_nested_access",
        "source": "document[\"0\"] = value",
        "source_span": {"start": 0, "end": 21},
        "base": "document",
        "segments": [
          {"kind": "path_segment", "source": "\"0\"", "source_span": {"start": 9, "end": 12}, "expression": {"kind": "string_literal", "source": "\"0\"", "source_span": {"start": 9, "end": 12}}}
        ],
        "value": {"kind": "identifier", "source": "value", "source_span": {"start": 16, "end": 21}}
      }
    },
    {
      "id": "unicode_scalar_ast_spans",
      "source": "document[\"é\"] = \"值\"",
      "expected_ast": {
        "kind": "assign_nested_access",
        "source": "document[\"é\"] = \"值\"",
        "source_span": {"start": 0, "end": 19},
        "base": "document",
        "segments": [
          {"kind": "path_segment", "source": "\"é\"", "source_span": {"start": 9, "end": 12}, "expression": {"kind": "string_literal", "source": "\"é\"", "source_span": {"start": 9, "end": 12}}}
        ],
        "value": {"kind": "string_literal", "source": "\"值\"", "source_span": {"start": 16, "end": 19}}
      }
    }
  ],
  "invalid_syntax_cases": [
    {"id": "temporary_root", "source": "make_document()[\"x\"] = value", "diagnostic": {"code": "nested_write_root_not_addressable", "stage": "action_parse", "source_span": {"source_id": "contract:temporary_root", "start": 0, "end": 15, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write root must remain a bare identifier"}},
    {"id": "literal_root", "source": "{}[\"x\"] = value", "diagnostic": {"code": "nested_write_root_not_addressable", "stage": "action_parse", "source_span": {"source_id": "contract:literal_root", "start": 0, "end": 2, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write root must be a bare identifier"}},
    {"id": "empty_segment", "source": "document[] = value", "diagnostic": {"code": "nested_write_segment_empty", "stage": "action_parse", "source_span": {"source_id": "contract:empty_segment", "start": 8, "end": 10, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write segment may not be empty"}},
    {"id": "unclosed_segment", "source": "document[\"x\" = value", "diagnostic": {"code": "nested_write_segment_unclosed", "stage": "action_parse", "source_span": {"source_id": "contract:unclosed_segment", "start": 8, "end": 12, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write segment is missing its closing bracket"}},
    {"id": "invalid_segment_expression", "source": "document[0:1] = value", "diagnostic": {"code": "nested_write_segment_expression_invalid", "stage": "action_parse", "source_span": {"source_id": "contract:invalid_segment_expression", "start": 9, "end": 12, "unit": "unicode_scalar", "provenance": "authored"}, "message": "segment must be one balanced ActionIR value expression"}},
    {"id": "property_root", "source": "document.value[\"x\"] = value", "diagnostic": {"code": "nested_write_root_not_addressable", "stage": "action_parse", "source_span": {"source_id": "contract:property_root", "start": 0, "end": 14, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write root must remain a bare identifier"}},
    {"id": "reserved_root", "source": "retv[\"x\"] = value", "diagnostic": {"code": "nested_write_root_reserved", "stage": "action_parse", "source_span": {"source_id": "contract:reserved_root", "start": 0, "end": 4, "unit": "unicode_scalar", "provenance": "authored"}, "message": "nested write root 'retv' is reserved"}}
  ],
  "excluded_syntax_cases": [
    {"id": "ordinary_scalar_assignment", "source": "document = value", "classification": "not_nested_write"},
    {"id": "read_expression", "source": "document[\"x\"]", "classification": "read_only"},
    {"id": "invented_wrapper", "source": "vivify(document, \"x\", value)", "classification": "unsupported_helper"},
    {"id": "invented_operator", "source": "document[\"x\"] := value", "classification": "unsupported_operator"}
  ],
  "success_cases": [
    {
      "id": "absent_harray_array_harray_chain",
      "source": "document[\"sections\"][0][\"title\"] = \"Intro\"",
      "binding": "document",
      "initial_binding": {"present": false},
      "segments": [
        {"source": "\"sections\"", "kind": "string", "value": "sections"},
        {"source": "0", "kind": "integer", "value": 0},
        {"source": "\"title\"", "kind": "string", "value": "title"}
      ],
      "rhs": {"source": "\"Intro\"", "value": "Intro"},
      "expected_effects": ["segment:0", "segment:1", "segment:2", "rhs"],
      "expected_binding": {"sections": [{"title": "Intro"}]},
      "expected_result": {"sections": [{"title": "Intro"}]}
    },
    {
