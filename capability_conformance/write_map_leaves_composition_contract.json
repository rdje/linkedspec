{
  "format": 1,
  "contract_id": "linkedspec-write-map-leaves-composition-v1",
  "status": "future-neutral-composition; no backend behavior admitted",
  "requires": {
    "write_vivification": {
      "contract_id": "linkedspec-write-vivification-v1",
      "path": "capability_conformance/write_vivification_contract.json",
      "canonical_json_sha256": "efabe777bf7fa5d7c3fa6e6fbe181bba89931b8c9b93a3631013c1f6009a2663"
    },
    "map_leaves_mutation": {
      "contract_id": "linkedspec-map-leaves-mutation-v1",
      "path": "capability_conformance/map_leaves_mutation_contract.json",
      "canonical_json_sha256": "a15c6dd363b4cb8cbd5d3d6781b4abc0bf0412b7ee3eb7576a3c674bf19d2db9"
    }
  },
  "policy": {
    "callback_write": "a map_leaves! callback may use ordinary nested write-vivification against its detached value or any binding identity other than the active receiver",
    "identity_guard": "the map_leaves! guard compares resolved binding identity before evaluating a nested-write segment or RHS; spelling alone neither triggers nor bypasses the guard",
    "callback_value": "vivifying the detached callback value changes only that callback-local value; the returned updated root becomes the replacement and is not revisited during the same traversal",
    "unrelated_success": "a successful nested write to an unrelated binding commits with ordinary write semantics independently of the later map_leaves! receiver commit",
    "unrelated_failure": "a failed unrelated nested write propagates its unchanged diagnostic, retains completed expression effects under the write contract, and aborts map_leaves! before receiver commit",
    "later_callback_failure": "unrelated writes completed by earlier or current callbacks persist when a later callback failure prevents the receiver commit",
    "same_receiver_precedence": "a nested write through the active receiver identity fails with receiver_mutation_reentrant before segment or RHS evaluation and therefore precedes every latent nested-write diagnostic",
    "shadow_identity": "a helper parameter or scoped binding with the receiver spelling but a distinct identity may vivify normally without writing the guarded receiver",
    "post_commit": "ordinary caller-scoped continuation begins after map_leaves! publishes its leaf updates and after the guard is released; a nested write reached there follows the write contract, while its failure preserves the earlier leaf publication",
    "detachment": "callback values, nested-write results and RHS aggregates, traversal snapshots, committed bindings, returned roots, unrelated bindings, and shadow locals remain detached across their contract boundaries",
    "current_boundary": "until backend implementation leaves land, the composed source stops at the unsupported map_leaves! token before callback nested-write lowering or runtime on Perl, Rust, Dart, Julia, PUC Lua, and LuaJIT"
  },
  "callback_cases": [
    {
      "id": "callback_value_vivifies_and_replaces_without_revisit",
      "source": "tree.map_leaves!() { value[0][\"name\"] = \"A\"; return(value) }",
      "helper_sources": {},
      "binding": "tree",
      "initial_bindings": {"tree": {"leaf": []}},
      "initial_locals": {},
      "callback_steps": [
        {
          "frame": {"value": [], "key": "leaf", "path": ["leaf"], "depth": 1},
          "write": {
            "container": "callback",
            "target": {"storage": "callback_value", "name": "value", "identity": "callback_value_vivifies_and_replaces_without_revisit:callback:0:value"},
            "source": "value[0][\"name\"] = \"A\"",
            "segments": [
              {"source": "0", "kind": "integer", "value": 0},
              {"source": "\"name\"", "kind": "string", "value": "name"}
            ],
            "rhs": {"source": "\"A\"", "value": "A"},
            "expected_initial_binding": {"present": true, "value": []},
            "expected_effects": ["segment:0", "segment:1", "rhs"],
            "expected_binding": {"present": true, "value": [{"name": "A"}]},
            "expected_result": [{"name": "A"}]
          },
          "result_source": "write_result"
        }
      ],
      "expected_bindings": {"tree": {"leaf": [{"name": "A"}]}},
      "expected_locals": {},
      "expected_result": {"leaf": [{"name": "A"}]},
      "expected_effects": ["write:value:segment:0", "write:value:segment:1", "write:value:rhs", "callback:leaf", "commit:tree"]
    },
