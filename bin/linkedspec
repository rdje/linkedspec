#!/usr/bin/env perl
use strict;
use warnings;
use 5.010;

use Encode qw(encode is_utf8);
use FindBin;
use JSON::PP;
use lib "$FindBin::Bin/../perl";

use LinkedSpec;

sub _usage {
 return <<'USAGE';
Usage:
  perl bin/linkedspec --spec NAME --input TEXT [options]
  perl bin/linkedspec --spec-file PATH --input-file PATH [options]
  perl bin/linkedspec --inline-spec TEXT --input TEXT [options]

Source selection (choose exactly one):
  --spec NAME          Resolve and compile a named .spec
  --spec-file PATH     Compile .spec source read from PATH
  --inline-spec TEXT   Compile the literal .spec source TEXT

Input selection (choose exactly one):
  --input TEXT         Parse TEXT
  --input-file PATH    Parse file contents read from PATH

Parser options:
  --top-rule NAME      Select the entry rule
  --parse-mode MODE    MODE is seek or consume

Trace options:
  --trace LEVEL        LEVEL is none/quiet, low, medium/med, high, full,
                       debug/verbose, or an integer
  --trace-file PATH    Write trace output to PATH
  --trace-mode MODE    MODE is stdout, route, or mirror
  --trace-reset        Truncate --trace-file before writing
  --trace-emoji        Enable emoji trace prefixes

Help:
  --help, -h           Show this help

Trace output:
  Emits deterministic compile/input/invoke phase records shared by every primary
  backend command. Native embedding APIs retain richer backend-internal events.

Output:
  Prints the parser result as canonical JSON on stdout. When trace output is sent
  to stdout it is intentionally interleaved with that JSON; use --trace-file with
  --trace-mode route for machine-readable stdout plus routed trace.

Failures:
  Compilation, input-load, and parser-invocation failures write one stable phase
  heading to stderr and exit 1. Usage errors write this help and exit 2.

Examples:
  perl bin/linkedspec --spec Lispish --input '(hello world)'
  perl bin/linkedspec --spec-file demo.spec --input-file demo.txt \
    --trace high --trace-file linkedspec.trace.log --trace-mode route --trace-reset
USAGE
}

sub _slurp {
 my ($path, $label) = @_;
 open(my $fh, '<', $path) or die "cannot read $label '$path': $!\n";
 local $/;
 my $content = <$fh>;
 close($fh);
 return defined($content) ? $content : '';
}

sub _defined_count {
 my $count = 0;
 foreach my $value (@_) {
  ++$count if defined $value;
 }
 return $count;
}

sub _valid_trace_level {
 my ($level) = @_;
 return 1 if !defined $level;
 return 1 if $level =~ /\A-?\d+\z/;
 return $level =~ /\A(?:none|quiet|low|medium|med|high|full|debug|verbose)\z/i ? 1 : 0;
}

sub _trace_level_number {
 my ($level) = @_;
 return 0 unless defined $level;
 return int($level) if $level =~ /\A-?\d+\z/;
 my %named = (
  none => 0,
  quiet => 0,
  low => 100,
  medium => 200,
  med => 200,
  high => 300,
  full => 400,
  debug => 500,
  verbose => 500,
 );
 return $named{lc $level};
}

sub _trace_emoji_prefix {
 my ($level) = @_;
 return chr(0x2139).chr(0xFE0F) if $level == 100;
 return chr(0x1F50E) if $level == 200;
 return chr(0x1F9ED) if $level == 300;
 return chr(0x1F41E) if $level == 400;
 return chr(0x1F525);
}

sub _utf8_bytes {
 my ($value) = @_;
 $value = '' unless defined $value;
 return is_utf8($value) ? encode('UTF-8', $value) : $value;
}

sub _trace_field {
 my ($value) = @_;
 my $bytes = _utf8_bytes($value);
 $bytes =~ s/([^A-Za-z0-9_.:-])/sprintf('%%%02X', ord($1))/ge;
 return $bytes;
}

sub _trace_file_write {
 my ($path, $bytes, $truncate) = @_;
 my $mode = $truncate ? '>:raw' : '>>:raw';
 open(my $fh, $mode, $path) or _runtime_error('parser compilation failed');
 print {$fh} $bytes or _runtime_error('parser compilation failed');
 close($fh) or _runtime_error('parser compilation failed');
 return 1;
}

sub _trace_config {
 my ($opt) = @_;
 my $file = defined($opt->{trace_file}) && length($opt->{trace_file})
  ? $opt->{trace_file}
  : undef;
 my $mode = defined($opt->{trace_mode})
  ? $opt->{trace_mode}
  : (defined($file) ? 'route' : 'stdout');
 my $trace = {
  level => _trace_level_number($opt->{trace_level}),
  file => $file,
  mode => $mode,
  emoji => $opt->{trace_emoji} ? 1 : 0,
 };
 _trace_file_write($file, '', 1) if $opt->{trace_reset} && defined $file;
 return $trace;
}

sub _trace_emit {
 my ($trace, $level, $level_name, $event) = @_;
 return 0 unless ref($trace) eq 'HASH' && $trace->{level} >= $level;
 my $emoji = $trace->{emoji} ? _trace_emoji_prefix($level).' ' : '';
 my $bytes = _utf8_bytes("[linkedspec][$level_name] ${emoji}${event}\n");
 print STDOUT $bytes if $trace->{mode} eq 'stdout' || $trace->{mode} eq 'mirror';
 if (defined($trace->{file}) && ($trace->{mode} eq 'route' || $trace->{mode} eq 'mirror')) {
  _trace_file_write($trace->{file}, $bytes, 0);
 }
 return 1;
}

sub _utf8_length {
 my ($value) = @_;
 return length(_utf8_bytes($value));
}

sub _split_option {
 my ($argument) = @_;
 if (defined($argument) && $argument =~ /\A(--[^=]+)=(.*)\z/s) {
  return ($1, $2);
 }
 return ($argument, undef);
}

sub _parse_args {
 my (@arguments) = @_;
 my %value_option = (
  '--spec'        => 'spec',
  '--spec-file'   => 'spec_file',
  '--inline-spec' => 'inline_spec',
  '--input'       => 'input',
  '--input-file'  => 'input_file',
  '--top-rule'    => 'top_rule',
  '--parse-mode'  => 'parse_mode',
  '--trace'       => 'trace_level',
  '--trace-file'  => 'trace_file',
  '--trace-mode'  => 'trace_mode',
 );
 my %opt;
 my $help = 0;
 my @errors;

 for (my $index = 0; $index < @arguments; ++$index) {
  my $argument = $arguments[$index];
  my ($option, $inline_value) = _split_option($argument);
  if ($option eq '--help' || $option eq '-h') {
   if (defined $inline_value) {
    push @errors, "$option does not accept a value";
   } else {
    $help = 1;
   }
  } elsif ($option eq '--trace-reset' || $option eq '--trace-emoji') {
   if (defined $inline_value) {
    push @errors, "$option does not accept a value";
   } else {
    my $key = $option eq '--trace-reset' ? 'trace_reset' : 'trace_emoji';
    $opt{$key} = 1;
   }
  } elsif (exists $value_option{$option}) {
   my $value;
   if (defined $inline_value) {
    $value = $inline_value;
   } elsif ($index == $#arguments) {
    push @errors, "$option requires a value";
    next;
   } else {
    ++$index;
    $value = $arguments[$index];
   }
   $opt{$value_option{$option}} = $value;
  } elsif (defined($option) && $option =~ /\A-/) {
   push @errors, "unknown option '$option'";
  } else {
   push @errors, "unexpected positional argument '$argument'";
  }
 }

 _usage_error(join('; ', @errors)) if @errors;
 return (\%opt, $help) if $help;

 _usage_error('choose exactly one source option: --spec, --spec-file, or --inline-spec')
  unless _defined_count(@opt{qw/spec spec_file inline_spec/}) == 1;
 _usage_error('choose exactly one input option: --input or --input-file')
  unless _defined_count(@opt{qw/input input_file/}) == 1;
 if (defined($opt{parse_mode}) && $opt{parse_mode} !~ /\A(?:seek|consume)\z/) {
  _usage_error("--parse-mode must be 'seek' or 'consume'");
 }
 if (!_valid_trace_level($opt{trace_level})) {
  _usage_error("--trace has an unsupported level '$opt{trace_level}'");
 }
 if (defined($opt{trace_mode}) && $opt{trace_mode} !~ /\A(?:stdout|route|mirror)\z/) {
  _usage_error("--trace-mode must be 'stdout', 'route', or 'mirror'");
 }
 return (\%opt, 0);
}

sub _usage_error {
 my ($message) = @_;
 print STDERR "linkedspec: $message\n\n";
 print STDERR _usage();
 exit 2;
}

sub _runtime_error {
 my ($message) = @_;
 print STDERR "linkedspec: $message\n";
 exit 1;
}

my ($opt_ref, $help) = _parse_args(@ARGV);
my %opt = %$opt_ref;

if ($help) {
 print _usage();
 exit 0;
}

binmode STDOUT, ':raw';
binmode STDERR, ':raw';
my $trace = _trace_config(\%opt);

my %compile_opts;
my %runtime_ctx;
$compile_opts{runtime_ctx_ref} = \%runtime_ctx;
$compile_opts{top_rule} = $opt{top_rule} if defined $opt{top_rule};
$compile_opts{parse_mode} = $opt{parse_mode} if defined $opt{parse_mode};
delete @ENV{qw(
 LINKEDSPEC_TRACE_LEVEL
 LINKEDSPEC_DUMP_VERBOSITY
 LINKEDSPEC_TRACE_FILE
 LINKEDSPEC_TRACE_MIRROR_STDOUT
 LINKEDSPEC_TRACE_RESET_FILE
 LINKEDSPEC_TRACE_EMOJI
)};
$compile_opts{trace_level} = -1;
$compile_opts{trace_log_file} = '';
$compile_opts{trace_log_mode} = 'route';
$compile_opts{trace_emoji} = 0;

my $source_kind = defined($opt{spec}) ? 'named' : defined($opt{spec_file}) ? 'file' : 'inline';
my $input_kind = defined($opt{input_file}) ? 'file' : 'literal';
my $source_argument = defined($opt{spec})
 ? $opt{spec}
 : defined($opt{spec_file}) ? $opt{spec_file} : $opt{inline_spec};
my $input_argument = defined($opt{input_file}) ? $opt{input_file} : $opt{input};
my $top_rule = defined($opt{top_rule}) ? _trace_field($opt{top_rule}) : '<default>';
my $parse_mode = defined($opt{parse_mode}) ? $opt{parse_mode} : 'seek';

_trace_emit($trace, 100, 'low', 'compile:start');
_trace_emit(
 $trace,
 200,
 'medium',
 "request source=$source_kind input=$input_kind top_rule=$top_rule parse_mode=$parse_mode",
);
_trace_emit(
 $trace,
 300,
 'high',
 'arguments source_bytes='._utf8_length($source_argument).' input_bytes='._utf8_length($input_argument),
);
_trace_emit($trace, 500, 'debug', 'protocol version=1');

my $parser;
my $compile_error;
if (defined $opt{spec}) {
 $parser = eval { LinkedSpec::get_parser($opt{spec}, %compile_opts) };
 $compile_error = $@;
} else {
 my $spec_source = defined($opt{spec_file})
  ? eval { _slurp($opt{spec_file}, 'spec file') }
  : $opt{inline_spec};
 $compile_error = $@ if $@;
 if (!defined $compile_error || !length $compile_error) {
  $parser = eval { LinkedSpec::Get(\$spec_source, %compile_opts) };
  $compile_error = $@;
 }
}

if ($compile_error || ref($parser) ne 'CODE') {
 _trace_emit($trace, 100, 'low', 'compile:error');
 _runtime_error('parser compilation failed');
}
_trace_emit($trace, 100, 'low', 'compile:ok');

_trace_emit($trace, 100, 'low', 'input:start');
my $input = defined($opt{input_file})
 ? eval { _slurp($opt{input_file}, 'input file') }
 : $opt{input};
if ($@) {
 _trace_emit($trace, 100, 'low', 'input:error');
 _runtime_error('input load failed');
}
_trace_emit($trace, 300, 'high', 'input bytes='._utf8_length($input));
_trace_emit($trace, 100, 'low', 'input:ok');

_trace_emit($trace, 100, 'low', 'invoke:start');
my $result = eval { $parser->(\$input) };
my $parse_error = $@;
if ($parse_error) {
 _trace_emit($trace, 100, 'low', 'invoke:error');
 _runtime_error('parser invocation failed');
}
_trace_emit($trace, 100, 'low', 'invoke:ok');

my $json = JSON::PP->new->canonical(1)->allow_nonref(1);
my $json_bytes = $json->encode($result);
_trace_emit($trace, 400, 'full', 'result json_bytes='._utf8_length($json_bytes));
print STDOUT _utf8_bytes($json_bytes), "\n";
exit 0;
