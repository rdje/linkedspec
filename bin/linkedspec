#!/usr/bin/env perl
use strict;
use warnings;
use 5.010;

use FindBin;
use JSON::PP;
use lib "$FindBin::Bin/../perl";

use LinkedSpec;

sub _usage {
 return <<'USAGE';
Usage:
  perl bin/linkedspec --spec NAME --input TEXT [options]
  perl bin/linkedspec --spec-file PATH --input-file PATH [options]
  perl bin/linkedspec --inline-spec TEXT --input TEXT [options]

Source selection (choose exactly one):
  --spec NAME          Resolve and compile a named .spec
  --spec-file PATH     Compile .spec source read from PATH
  --inline-spec TEXT   Compile the literal .spec source TEXT

Input selection (choose exactly one):
  --input TEXT         Parse TEXT
  --input-file PATH    Parse file contents read from PATH

Parser options:
  --top-rule NAME      Select the entry rule
  --parse-mode MODE    MODE is seek or consume

Trace options:
  --trace LEVEL        LEVEL is none/quiet, low, medium/med, high, full,
                       debug/verbose, or an integer
  --trace-file PATH    Write trace output to PATH
  --trace-mode MODE    MODE is stdout, route, or mirror
  --trace-reset        Truncate --trace-file before writing
  --trace-emoji        Enable emoji trace prefixes

Help:
  --help, -h           Show this help

Output:
  Prints the parser result as canonical JSON on stdout. When trace output is sent
  to stdout it is intentionally interleaved with that JSON; use --trace-file with
  --trace-mode route for machine-readable stdout plus routed trace.

Failures:
  Compilation, input-load, and parser-invocation failures write one stable phase
  heading to stderr and exit 1. Usage errors write this help and exit 2.

Examples:
  perl bin/linkedspec --spec Lispish --input '(hello world)'
  perl bin/linkedspec --spec-file demo.spec --input-file demo.txt \
    --trace high --trace-file linkedspec.trace.log --trace-mode route --trace-reset
USAGE
}

sub _slurp {
 my ($path, $label) = @_;
 open(my $fh, '<', $path) or die "cannot read $label '$path': $!\n";
 local $/;
 my $content = <$fh>;
 close($fh);
 return defined($content) ? $content : '';
}

sub _defined_count {
 my $count = 0;
 foreach my $value (@_) {
  ++$count if defined $value;
 }
 return $count;
}

sub _valid_trace_level {
 my ($level) = @_;
 return 1 if !defined $level;
 return 1 if $level =~ /\A-?\d+\z/;
 return $level =~ /\A(?:none|quiet|low|medium|med|high|full|debug|verbose)\z/i ? 1 : 0;
}

sub _split_option {
 my ($argument) = @_;
 if (defined($argument) && $argument =~ /\A(--[^=]+)=(.*)\z/s) {
  return ($1, $2);
 }
 return ($argument, undef);
}

sub _parse_args {
 my (@arguments) = @_;
 my %value_option = (
  '--spec'        => 'spec',
  '--spec-file'   => 'spec_file',
  '--inline-spec' => 'inline_spec',
  '--input'       => 'input',
  '--input-file'  => 'input_file',
  '--top-rule'    => 'top_rule',
  '--parse-mode'  => 'parse_mode',
  '--trace'       => 'trace_level',
  '--trace-file'  => 'trace_file',
  '--trace-mode'  => 'trace_mode',
 );
 my %opt;
 my $help = 0;
 my @errors;

 for (my $index = 0; $index < @arguments; ++$index) {
  my $argument = $arguments[$index];
  my ($option, $inline_value) = _split_option($argument);
  if ($option eq '--help' || $option eq '-h') {
   if (defined $inline_value) {
    push @errors, "$option does not accept a value";
   } else {
    $help = 1;
   }
  } elsif ($option eq '--trace-reset' || $option eq '--trace-emoji') {
   if (defined $inline_value) {
    push @errors, "$option does not accept a value";
   } else {
    my $key = $option eq '--trace-reset' ? 'trace_reset' : 'trace_emoji';
    $opt{$key} = 1;
   }
  } elsif (exists $value_option{$option}) {
   my $value;
   if (defined $inline_value) {
    $value = $inline_value;
   } elsif ($index == $#arguments) {
    push @errors, "$option requires a value";
    next;
   } else {
    ++$index;
    $value = $arguments[$index];
   }
   $opt{$value_option{$option}} = $value;
  } elsif (defined($option) && $option =~ /\A-/) {
   push @errors, "unknown option '$option'";
  } else {
   push @errors, "unexpected positional argument '$argument'";
  }
 }

 _usage_error(join('; ', @errors)) if @errors;
 return (\%opt, $help) if $help;

 _usage_error('choose exactly one source option: --spec, --spec-file, or --inline-spec')
  unless _defined_count(@opt{qw/spec spec_file inline_spec/}) == 1;
 _usage_error('choose exactly one input option: --input or --input-file')
  unless _defined_count(@opt{qw/input input_file/}) == 1;
 if (defined($opt{parse_mode}) && $opt{parse_mode} !~ /\A(?:seek|consume)\z/) {
  _usage_error("--parse-mode must be 'seek' or 'consume'");
 }
 if (!_valid_trace_level($opt{trace_level})) {
  _usage_error("--trace has an unsupported level '$opt{trace_level}'");
 }
 if (defined($opt{trace_mode}) && $opt{trace_mode} !~ /\A(?:stdout|route|mirror)\z/) {
  _usage_error("--trace-mode must be 'stdout', 'route', or 'mirror'");
 }
 return (\%opt, 0);
}

sub _usage_error {
 my ($message) = @_;
 print STDERR "linkedspec: $message\n\n";
 print STDERR _usage();
 exit 2;
}

sub _runtime_error {
 my ($message) = @_;
 print STDERR "linkedspec: $message\n";
 exit 1;
}

my ($opt_ref, $help) = _parse_args(@ARGV);
my %opt = %$opt_ref;

if ($help) {
 print _usage();
 exit 0;
}

my %compile_opts;
my %runtime_ctx;
$compile_opts{runtime_ctx_ref} = \%runtime_ctx;
$compile_opts{top_rule} = $opt{top_rule} if defined $opt{top_rule};
$compile_opts{parse_mode} = $opt{parse_mode} if defined $opt{parse_mode};
my $trace_selected = defined($opt{trace_level})
 || defined($opt{trace_file})
 || defined($opt{trace_mode})
 || $opt{trace_reset}
 || $opt{trace_emoji};
if ($trace_selected) {
 $compile_opts{trace_level} = $opt{trace_level} if defined $opt{trace_level};
 $compile_opts{trace_log_file} = $opt{trace_file} if defined $opt{trace_file};
 $compile_opts{trace_log_mode} = $opt{trace_mode} if defined $opt{trace_mode};
 $compile_opts{trace_reset_log} = 1 if $opt{trace_reset};
 $compile_opts{trace_emoji} = 1 if $opt{trace_emoji};
} else {
 delete @ENV{qw(
  LINKEDSPEC_TRACE_LEVEL
  LINKEDSPEC_DUMP_VERBOSITY
  LINKEDSPEC_TRACE_FILE
  LINKEDSPEC_TRACE_MIRROR_STDOUT
  LINKEDSPEC_TRACE_RESET_FILE
  LINKEDSPEC_TRACE_EMOJI
 )};
 $compile_opts{trace_level} = -1;
 $compile_opts{trace_log_file} = '';
 $compile_opts{trace_log_mode} = 'route';
 $compile_opts{trace_emoji} = 0;
}

my $parser;
my $compile_error;
if (defined $opt{spec}) {
 $parser = eval { LinkedSpec::get_parser($opt{spec}, %compile_opts) };
 $compile_error = $@;
} else {
 my $spec_source = defined($opt{spec_file})
  ? eval { _slurp($opt{spec_file}, 'spec file') }
  : $opt{inline_spec};
 $compile_error = $@ if $@;
 if (!defined $compile_error || !length $compile_error) {
  $parser = eval { LinkedSpec::Get(\$spec_source, %compile_opts) };
  $compile_error = $@;
 }
}

_runtime_error('parser compilation failed')
 if $compile_error || ref($parser) ne 'CODE';

my $input = defined($opt{input_file})
 ? eval { _slurp($opt{input_file}, 'input file') }
 : $opt{input};
_runtime_error('input load failed') if $@;

my $result = eval { $parser->(\$input) };
my $parse_error = $@;
_runtime_error('parser invocation failed') if $parse_error;

my $json = JSON::PP->new->canonical(1)->allow_nonref(1);
print $json->encode($result), "\n";
exit 0;
