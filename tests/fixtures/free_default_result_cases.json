    "rule": "Value",
    "body": "return([coalesce(undef,\" tail \").trim().uppercase(),coalesce_nonempty(\"\",0).add(1),coalesce(false,true).not(),coalesce_nonempty(undef,\"tail\").cat(\"!\")])",
    "source": "Value::\n I {return([coalesce(undef,\" tail \").trim().uppercase(),coalesce_nonempty(\"\",0).add(1),coalesce(false,true).not(),coalesce_nonempty(undef,\"tail\").cat(\"!\")])}\n",
    "input": "x",
    "input_characters": 1,
    "leading_codepoint": 120,
    "expected": [
