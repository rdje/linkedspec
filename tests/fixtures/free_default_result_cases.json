    "id": "with_kinds_and_outer_scope",
    "rule": "Value",
    "body": "value=\"outer\";order=\"\";a=coalesce(undef,\"tail\").with(){return({\"k\":[value,\"tail\"]})}[\"k\"][-1].uppercase();bad=coalesce_nonempty(\"\",\"tail\").take({order=cat(order,\"A\");1}).with(){order=cat(order,\"W\");return(\"ran\")};return([a,bad,value,order])",
    "source": "Value::\n I {value=\"outer\";order=\"\";a=coalesce(undef,\"tail\").with(){return({\"k\":[value,\"tail\"]})}[\"k\"][-1].uppercase();bad=coalesce_nonempty(\"\",\"tail\").take({order=cat(order,\"A\");1}).with(){order=cat(order,\"W\");return(\"ran\")};return([a,bad,value,order])}\n",
    "input": "x",
