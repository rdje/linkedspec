[
  {
    "id": "scalar_primitives",
    "rule": "Value",
    "body": "return([coalesce(undef,\"tail\"),coalesce(\"\",\"late\"),coalesce(0,7),coalesce(false,true),coalesce(undef,undef),coalesce_nonempty(\"\",0,\"late\"),coalesce_nonempty(undef,false,\"late\"),coalesce_nonempty(undef,\"\")])",
    "source": "Value::\n I {return([coalesce(undef,\"tail\"),coalesce(\"\",\"late\"),coalesce(0,7),coalesce(false,true),coalesce(undef,undef),coalesce_nonempty(\"\",0,\"late\"),coalesce_nonempty(undef,false,\"late\"),coalesce_nonempty(undef,\"\")])}\n",
    "input": "x",
    "input_characters": 1,
    "leading_codepoint": 120,
    "expected": [
      "tail",
      "",
      0,
      false,
      null,
      0,
      false,
      null
    ]
  },
  {
