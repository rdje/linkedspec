  {
    "id": "lazy_order_and_snapshot",
    "rule": "Value",
    "body": "order=\"\";items=[\"head\",\"tail\"];out=coalesce({order=cat(order,\"S\");undef},{order=cat(order,\"D\");items},{order=cat(order,\"L\");\"late\"})[{items=[\"new\"];order=cat(order,\"I\");-1}].cat({order=cat(order,\"C\");\"!\"}).uppercase();return([out,items,order])",
    "source": "Value::\n I {order=\"\";items=[\"head\",\"tail\"];out=coalesce({order=cat(order,\"S\");undef},{order=cat(order,\"D\");items},{order=cat(order,\"L\");\"late\"})[{items=[\"new\"];order=cat(order,\"I\");-1}].cat({order=cat(order,\"C\");\"!\"}).uppercase();return([out,items,order])}\n",
    "input": "x",
    "input_characters": 1,
    "leading_codepoint": 120,
    "expected": [
      "TAIL!",
      [
        "new"
      ],
      "SDIC"
    ]
  },
