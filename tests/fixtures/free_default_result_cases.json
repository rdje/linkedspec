  {
    "id": "function_scope",
    "rule": "Value",
    "body": "items=[\"caller\"];order=\"outer\";return([pick(),items,order])",
    "source": "fn pick(){order=\"\";items=[\"head\",\"tail\"];out=coalesce({order=cat(order,\"S\");undef},{order=cat(order,\"D\");items},{order=cat(order,\"L\");\"late\"})[{items=[\"new\"];order=cat(order,\"I\");-1}].cat({order=cat(order,\"C\");\"!\"}).uppercase();return([out,items,order])}\nValue::\n I {items=[\"caller\"];order=\"outer\";return([pick(),items,order])}\n",
    "input": "x",
    "input_characters": 1,
    "leading_codepoint": 120,
    "expected": [
