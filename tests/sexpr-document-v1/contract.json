    {
      "id": "leading_junk",
      "input": "junk (a)",
      "outcome": "reject",
      "reason": "Top-level input must contain only lists and trivia."
    },
    {
      "id": "interstitial_junk",
      "input": "(a) junk (b)",
      "outcome": "reject",
      "reason": "Every interstitial character must be valid trivia or a form."
    },
    {
      "id": "trailing_junk",
      "input": "(a) garbage ((( ",
      "outcome": "reject",
      "reason": "A valid prefix does not make a valid document."
    },
    {
      "id": "bare_top_atom",
      "input": "atom",
      "outcome": "reject",
      "reason": "Top-level atoms are not document forms."
    },
    {
      "id": "quoted_top_atom",
      "input": "\"value\"",
      "outcome": "reject",
      "reason": "Top-level strings are not document forms."
    },
    {
      "id": "extra_close",
      "input": "(a))",
      "outcome": "reject",
      "reason": "Unmatched closing parenthesis."
    },
    {
      "id": "leading_close",
      "input": ") (a)",
      "outcome": "reject",
      "reason": "Unmatched closing parenthesis before any form."
    },
    {
      "id": "missing_close",
      "input": "(a",
      "outcome": "reject",
      "reason": "Every opened list must close."
    },
    {
      "id": "nested_missing_close",
      "input": "(a (b)",
      "outcome": "reject",
      "reason": "Outer list remains open."
    },
    {
      "id": "unterminated_quote",
      "input": "(a \"broken)",
      "outcome": "reject",
      "reason": "Unterminated string cannot become an ordinary atom."
    },
    {
      "id": "escaped_final_quote",
      "input": "(a \"broken\\\")",
      "outcome": "reject",
      "reason": "The escaped quote cannot close the string."
    },
    {
      "id": "empty_brackets",
      "input": "([])",
      "outcome": "reject",
      "reason": "Square brackets are outside the document syntax."
    },
    {
      "id": "nonempty_brackets",
