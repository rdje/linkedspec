  {
    "name": "early_return",
    "source": "Top::\n -> Value {payload=call(Value);mark_here(after);return([payload,mark_pos(after)])}\nValue:\n /H/\n /cat/\n @capture_gaps\n LS {mark_here(before);return([gap_text(),match_text(),mark_pos(before)])}\n -> Value[1] {return(\"unreached\")}\n",
    "cases": [
      {
        "input": "Hcat",
        "expected": [
          [
            "",
            "cat",
            4
          ],
          4
        ],
        "expected_match": true,
        "expected_char_cursor": 4
      },
      {
        "input": "H-cat",
        "expected": [
          [
            "-",
            "cat",
            5
          ],
          5
        ],
        "expected_match": true,
        "expected_char_cursor": 5
      },
      {
        "input": "H😀cat",
        "expected": [
          [
            "😀",
            "cat",
            5
          ],
          5
        ],
        "expected_match": true,
        "expected_char_cursor": 5
      }
    ]
  },
