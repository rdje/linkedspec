[
  {
    "name": "zero",
    "source": "Value::AND{2}\n /H/\n /cat/ -> Value[1] {return(0)}\n",
    "cases": [
      {
        "input": "HcatHcat",
        "expected": [
          0,
          0
        ],
        "expected_cursor": 8,
        "expected_match": true
      },
      {
        "input": "Hcat",
        "expected": null,
        "expected_cursor": 4,
        "expected_match": false
      },
      {
        "input": "HcatHbad",
        "expected": null,
        "expected_cursor": 5,
        "expected_match": false
      }
    ]
  },
