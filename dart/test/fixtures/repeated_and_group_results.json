  {
    "name": "custom_it",
    "source": "Value::AND{2}\n I {seen=[]}\n /H/\n /cat/ -> Value[1] {return(0)}\n IT {push(seen,cursor_pos())}\n E {return(copy(seen))}\n",
    "cases": [
      {
        "input": "HcatHcat",
        "expected": [
          4,
          8
        ],
        "expected_cursor": 8,
        "expected_match": true
      }
    ]
  },
