  {
    "name": "nested_copy",
    "source": "Value::AND{2}\n I {seen=[]}\n /a/ -> Value[0] {push(seen,cursor_pos());return(copy(seen))}\n",
    "cases": [
      {
        "input": "aa",
        "expected": [
          [
            1
          ],
          [
            1,
            2
          ]
        ],
        "expected_cursor": 2,
        "expected_match": true
      }
    ]
  },
  {
    "name": "fluent_one_slot",
    "source": "Value::AND{2}\n /a/ -> Value[0] .return(0)\n",
    "cases": [
      {
        "input": "aa",
        "expected": [
          0,
          0
        ],
        "expected_cursor": 2,
        "expected_match": true
      },
      {
        "input": "a",
        "expected": null,
        "expected_cursor": 1,
        "expected_match": false
      }
    ]
  },
  {
    "name": "duplicate_reset",
    "source": "Value::AND{2}\n I {hits=0}\n /a/\n -> Value[0] {hits=add(hits,1)}\n -> Value[0] {return([cursor_pos(),hits])}\n",
    "cases": [
      {
        "input": "aaaa",
        "expected": [
          [
            2,
            1
          ],
          [
            4,
            2
          ]
        ],
        "expected_cursor": 4,
        "expected_match": true
      },
      {
        "input": "aaa",
        "expected": null,
        "expected_cursor": 3,
        "expected_match": false
      }
    ]
  },
  {
    "name": "ordinary_zero",
    "source": "Value::AND{1}\n /(?=a)/ -> Value[0] {return(0)}\n",
    "cases": [
      {
        "input": "a",
        "expected": [
          0
        ],
        "expected_cursor": 0,
        "expected_match": true
      }
    ]
  },
  {
    "name": "recognition_null",
    "source": "Top::\n I {tx=recognition_checkpoint();matched=recognize_once(tx,call(Value));payload=recognition_commit(tx);return([matched,payload,cursor_pos()])}\n /never/\nValue:AND{2}\n /H/\n /cat/ -> Value[1] {return(undef)}\n",
    "cases": [
      {
        "input": "HcatHcat",
        "expected": [
          true,
          [
            null,
            null
          ],
          8
        ],
        "expected_cursor": 8,
        "expected_match": true
      },
      {
        "input": "Hcat",
        "expected": [
          false,
          null,
          4
        ],
        "expected_cursor": 4,
        "expected_match": true
      },
      {
        "input": "HcatHbad",
        "expected": [
          false,
          null,
          5
        ],
        "expected_cursor": 5,
        "expected_match": true
      }
    ]
  }
