  "claims": [
    {
      "name": "publishing-checker-controls",
      "statement": "The admitted disclosure/identity checker accepts its positive fixtures and rejects the selected malformed, stale and missing-evidence controls.",
      "scope": "Embedded schema/source fixtures and the staged adoption candidate only; not semantic truth, input completeness, historical runtime replay, or whole-project audit completion. The record itself is a Git-versioned intrinsic fixture and has no self-hash.",
      "rederive": {
        "status": "checked",
        "command": "bash scripts/check_claim_verification.sh --self-test; bash tools/run_python_project_data.sh tools/test_claim_verification_staged.py",
        "granularity": "Each named fixture and each alternate-index mutation; not a suite-level attribute assigned to individual cases.",
        "result": "Embedded: 3 positive / 16 rejected controls. Actual staged: 6 positive / 8 rejected controls; unchanged default tier API, restored baseline, and identical real index."
      },
      "falsify": {
        "status": "checked",
        "hypothesis": "A nonempty evidence label or retained hash alone lets stale, untracked or missing evidence pass.",
        "oracle": "SHA256 of actual Git blobs, strict source membership and actual current task status; alternate-index mutations invoke the complete registered checker, independently of the positive fixture wording.",
        "red_control": "Wrong hashes/untracked producer/missing legs reject in the embedded validator; actual modified producer bytes, removed record, symlink mode, missing/duplicate owner declarations and a completed gap owner reject in the staged checker. Each mutation is reverted; the actual baseline passes again. A real historical Git producer passes and a missing historical revision rejects."
      },
