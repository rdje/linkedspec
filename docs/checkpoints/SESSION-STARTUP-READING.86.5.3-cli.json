      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {
          "text": "[[{\"label\":\"Part\",\"mode\":\"\",\"top\":0,\"type\":\"rule\"},{\"code\":\"{ignored=0}\",\"marker\":\"I\",\"type\":\"lifecycle\"},{\"pattern\":\"a\",\"slot_name\":\"first\",\"type\":\"regex\"},{\"pattern\":\"b\",\"slot_name\":\"second\",\"type\":\"regex\"},{\"pattern\":\"c\",\"type\":\"regex\"}]]\n"
        },
        "stderr": {
          "text": ""
        },
        "files": []
