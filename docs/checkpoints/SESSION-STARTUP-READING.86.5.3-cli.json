{
  "schema_version": 1,
  "suite": "same-line-regex-slot-permanent-grammar",
  "cases": [
    {
      "id": "separate_control",
      "family": "success",
      "args": [
        "--spec-file",
        "{{REPO_ROOT}}/specs/spec.spec",
        "--input",
        "Part:\n first=/a/\n second=/b/\n /c/\n"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {
          "text": "[[{\"label\":\"Part\",\"mode\":\"\",\"top\":0,\"type\":\"rule\"},{\"pattern\":\"a\",\"slot_name\":\"first\",\"type\":\"regex\"},{\"pattern\":\"b\",\"slot_name\":\"second\",\"type\":\"regex\"},{\"pattern\":\"c\",\"type\":\"regex\"}]]\n"
        },
        "stderr": {
          "text": ""
        },
        "files": []
      }
    },
    {
      "id": "header_members",
      "family": "success",
      "args": [
        "--spec-file",
        "{{REPO_ROOT}}/specs/spec.spec",
        "--input",
        "Part: first=/a/ second=/b/ /c/\n"
      ],
      "files": [],
      "expect": {
        "exit": 0,
        "stdout": {
          "text": "[[{\"label\":\"Part\",\"mode\":\"\",\"top\":0,\"type\":\"rule\"},{\"pattern\":\"a\",\"slot_name\":\"first\",\"type\":\"regex\"},{\"pattern\":\"b\",\"slot_name\":\"second\",\"type\":\"regex\"},{\"pattern\":\"c\",\"type\":\"regex\"}]]\n"
        },
        "stderr": {
          "text": ""
        },
        "files": []
      }
    },
    {
