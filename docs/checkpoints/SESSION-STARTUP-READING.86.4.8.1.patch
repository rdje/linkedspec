    ++$after while $after < $len && substr($text, $after, 1) =~ /\s/o;
+   return 0 if $after < $len && substr($text, $after, 1) =~ /[,\.]/o
+    && _grouped_regex_operand_closes($text, $idx, $pos);
    return 1 if $after >= $len || substr($text, $after, 1) =~ /[,;\.\)\]]/o;
    return 0;
   }
