+}
+
+sub _quote_segment_end_at {
+ my ($text, $cursor, $open, $close) = @_;
+ my $depth = 1;
+ while ($cursor < length($text)) {
+  my $char = substr($text, $cursor++, 1);
+  if ($char eq '\\') { ++$cursor; next; }
+  ++$depth if $open ne $close && $char eq $open;
+  return $cursor if $char eq $close && --$depth == 0;
+ }
+ return undef
+}
