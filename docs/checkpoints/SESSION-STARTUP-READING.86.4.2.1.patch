+
+# A closing slash alone cannot establish a multiline token: it may be the
+# opener of a later quote after division. Check the remaining lexical scopes,
+# without compiling or executing raw Perl. Ambiguous later slash calls retain
+# an explicit fallback stack, so long statement sequences do not recurse.
+sub _slash_continuation_is_closed {
+ my ($text, $start) = @_;
+ my $len = length($text);
+ my @pending = ([$start, '', 1]);
+ my %failed;
+ while (@pending) {
+  my ($cursor, $closers, $value_before) = @{pop @pending};
+  my @visited;
+  while ($cursor < $len) {
+   my $key = join(':', $cursor, $closers, $value_before);
+   last if $failed{$key};
+   push @visited, $key;
+   my $char = substr($text, $cursor, 1);
+   if ($char =~ /\s/o) {
+    $value_before = 0 if $char eq "\n" || $char eq "\r";
+    ++$cursor;
+    next;
+   }
+   if ($char eq '#') {
+    ++$cursor while $cursor < $len && substr($text, $cursor, 1) ne "\n";
+    next;
+   }
+   if ($char eq q{'} || $char eq q{"} || $char eq q{`}) {
+    my $end = _quote_segment_end_at($text, $cursor + 1, $char, $char);
+    last unless defined $end;
+    $cursor = $end;
+    $value_before = 1;
+    next;
+   }
+   if ($char =~ /[A-Za-z_]/o) {
+    my $word_start = $cursor++;
+    ++$cursor while $cursor < $len && substr($text, $cursor, 1) =~ /\w/o;
+    my $word = substr($text, $word_start, $cursor - $word_start);
+    if ($word =~ /\A(?:qr|qq|qx|q|m|s|tr|y)\z/o) {
+     my $open = $cursor;
+     ++$open while $open < $len && substr($text, $open, 1) =~ /[ \t]/o;
+     my $delimiter = substr($text, $open, 1);
+     if ($delimiter eq '/' || $delimiter eq '|' || $delimiter eq '<') {
+      my $close = $delimiter eq '<' ? '>' : $delimiter;
+      my $end = _quote_segment_end_at($text, $open + 1, $delimiter, $close);
+      last unless defined $end;
+      if ($word eq 's' || $word eq 'tr' || $word eq 'y') {
+       ++$end if $delimiter ne $close && substr($text, $end, 1) eq $delimiter;
+       $end = _quote_segment_end_at($text, $end, $delimiter, $close);
+       last unless defined $end;
+      }
+      $cursor = $end;
+      ++$cursor while $cursor < $len && substr($text, $cursor, 1) =~ /[A-Za-z]/o;
+     }
+    }
+    $value_before = 1;
+    next;
+   }
+   if ($char eq '/' && !$value_before) {
+    my $call_end = _slash_symbol_call_end_at($text, $cursor);
+    my $after = $call_end || $cursor;
+    ++$after while $after < $len && substr($text, $after, 1) =~ /\s/o;
+    my $newline = $call_end && substr($text, $call_end, $after - $call_end) =~ /[\r\n]/o;
+    my $call_allowed = $call_end && ($after == $len
+     || substr($text, $after, 1) =~ /[,;\.\)\]]/o
+     || ($newline && substr($text, $after, 1) ne '}'));
+    my $literal_end = _slash_literal_end_at($text, $cursor);
+    if ($call_allowed && !$newline) {
+     $cursor = $call_end;
+    } elsif (defined $literal_end) {
+     push @pending, [$call_end, $closers, 1] if $call_allowed;
+     $cursor = $literal_end;
+    } elsif ($call_allowed) {
+     $cursor = $call_end;
+    } else {
+     last;
+    }
+    $value_before = 1;
+    next;
+   }
+   if ($char =~ /[\(\[\{]/o) {
+    $closers .= $char eq '(' ? ')' : $char eq '[' ? ']' : '}';
+    $value_before = 0;
+   } elsif ($char =~ /[\)\]\}]/o) {
+    return 1 unless length $closers; # Return to the caller's enclosing scope.
+    last unless substr($closers, -1, 1) eq $char;
+    chop $closers;
+    $value_before = 1;
+   } else {
+    $value_before = $char =~ /[\d.]/o ? 1 : 0;
+   }
