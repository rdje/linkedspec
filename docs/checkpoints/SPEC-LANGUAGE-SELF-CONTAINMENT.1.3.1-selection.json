  "sources": {
    "callable-controls.pl": {
      "path": ".linkedspec-data/scratch/selfcontain131/callable-controls.pl",
      "sha256": "dfc99d3dd63b5e63392f546935b749d783cd2734bd98d4f43bc827660af71224",
      "text": "use strict;\nuse warnings;\nuse utf8;\nuse LinkedSpec ();\nuse JSON::PP ();\nuse Scalar::Util qw(blessed reftype);\nsub project {\n my ($value) = @_;\n return [map { project($_) } @$value] if (reftype($value) // '') eq 'ARRAY';\n if ((reftype($value) // '') eq 'HASH') {\n  my %fields = map { $_ => project($value->{$_}) } keys %$value;\n  $fields{observed_class} = blessed($value) if blessed($value);\n  return \\%fields;\n }\n return $value;\n}\nmy @cases = (\n ['direct_push', q{Top:: I { seen=[]; push(seen,\"x\"); return(seen) }}],\n ['callback_push', q{Top:: I { seen=[]; cb={|| push(seen,\"x\"); return(seen) }; return(cb()) }}],\n ['direct_function', qq{fn decorate(text,prefix) { return(cat(prefix,text)) }\\nTop:: I { return(decorate(\"x\",\"!\")) }}],\n ['callback_function', qq{fn decorate(text,prefix) { return(cat(prefix,text)) }\\nTop:: I { cb={|| return(decorate(\"x\",\"!\")) }; return(cb()) }}],\n ['callback_cat_assignment', q{Top:: I { seen=\"before:\"; cb={|x| seen=cat(seen,x); return(cat(\"!\",x)) }; result=cb(\"x\"); return([result,seen]) }}],\n ['direct_uppercase', q{Top:: I { return(uppercase(\"ab\")) }}],\n ['function_uppercase', qq{fn decorate(text,prefix) { return(cat(prefix,uppercase(text))) }\\nTop:: I { return(decorate(\"ab\",\"!\")) }}],\n);\nfor my $case (@cases) {\n my ($id,$source) = @$case;\n my %ctx;\n my $parser = LinkedSpec::Get(\\$source, runtime_ctx_ref=>\\%ctx);\n die \"no parser for $id\" unless ref($parser) eq 'CODE';\n my $input='x';\n my $value=$parser->(\\$input);\n my $descriptor=LinkedSpec::Get(\\$source, return_descriptor=>1);\n my $meta=$descriptor->{spec}{Top}{meta}{action_rewriter};\n print JSON::PP->new->canonical->encode({\n  id=>$id, source=>$source, value=>project($value), last_error=>project($ctx{last_error}),\n  metadata=>{map {$_=>$meta->{$_}} qw(canonical_action_ir_fallback_count raw_perl_dependency_count unresolved_helper_count language_agnostic_action_ir_ready)},\n }), \"\\n\";\n}\n"
    },
    "diagnostic.spec": {
      "path": ".linkedspec-data/scratch/selfcontain131/diagnostic.spec",
      "sha256": "fba66e47d14b1a236deb1136ec2c515fa629f8a1d8dce36812431ebe8bc62fc0",
      "text": "Top::\n -> Word {\n   if(num_ne(match_start_pos(), 0)) { exit_now(1) }\n   if(num_ne(match_end_pos(), input_end_pos())) { exit_now(1) }\n   effects = []\n   print({ push(effects, \"left\"); return(\"begin:\") },\n         { push(effects, \"right\"); return(match_text()) })\n   if(str_eq(match_text(), \"stop\")) { say(\"stop\"); exit_now(7) }\n   print_each([\"α\", undef, [], \"🙂\"], \"part:\", \"!\")\n   say(\"done\")\n   return({ \"word\": match_text(), \"effects\": copy(effects), \"payload\": false })\n }\nLX { exit_now(1) }\n\nWord:\n /([a-z]+)/\n"
    },
    "pilot.pl": {
      "path": ".linkedspec-data/scratch/selfcontain131/pilot.pl",
      "sha256": "21f316cdccc45c95d3e6e3032b504e00f50fd8cd4027f8c9936c2553176b9151",
      "text": "use strict;\nuse warnings;\nuse utf8;\nuse LinkedSpec ();\nuse JSON::PP ();\nuse Scalar::Util qw(blessed reftype refaddr);\nbinmode STDOUT, ':encoding(UTF-8)';\nsub project {\n my ($value) = @_;\n return [map { project($_) } @$value] if (reftype($value) // '') eq 'ARRAY';\n if ((reftype($value) // '') eq 'HASH') {\n  my %fields = map { $_ => project($value->{$_}) } keys %$value;\n  $fields{observed_class} = blessed($value) if blessed($value);\n  return \\%fields;\n }\n return $value;\n}\nlocal $/;\nopen my $fh, '<:encoding(UTF-8)', $ARGV[0] // '.linkedspec-data/scratch/selfcontain131/pipeline.spec' or die $!;\nmy $source = <$fh>;\nmy %ctx;\nmy $parser = LinkedSpec::Get(\\$source, runtime_ctx_ref => \\%ctx);\ndie 'no parser' unless ref($parser) eq 'CODE';\nmy (@events, $result, $error);\nmy $input = $ARGV[1] // 'ab-cd';\nmy $mode = $ARGV[2] // 'sink';\nmy $token = bless {tag=>'selection_sink_failure'}, 'Selection::SinkFailure';\nmy $options = $mode eq 'quiet' ? {} : {diagnostic_sink => sub {\n push @events, {%{$_[0]}};\n die $token if $mode eq 'throw2' && @events == 2;\n}};\neval { $result = $parser->(\\$input, $options); 1 } or $error = $@;\nprint JSON::PP->new->canonical->allow_nonref->encode({\n result => project($result), events => \\@events, last_error => project($ctx{last_error}),\n failure => $error ? \"$error\" : undef,\n failure_detail => project($error),\n sink_identity_preserved => $mode eq 'throw2' ? (ref($error) && refaddr($error)==refaddr($token) ? JSON::PP::true : JSON::PP::false) : undef,\n}), \"\\n\";\nmy $descriptor = LinkedSpec::Get(\\$source, return_descriptor => 1);\nmy $meta = $descriptor->{spec}{Top}{meta}{action_rewriter};\nprint JSON::PP->new->canonical->encode({map {$_=>$meta->{$_}}\n qw(canonical_action_ir_count canonical_action_ir_fallback_count raw_perl_dependency_count unresolved_helper_count language_agnostic_action_ir_ready)}), \"\\n\";\n"
    },
    "pipeline-initial.spec": {
      "path": ".linkedspec-data/scratch/selfcontain131/pipeline-initial.spec",
      "sha256": "da2492f7e7770b4ed9cf22d20fcdf6333379e8240a1ad02d2619bf1f538e938e",
      "text": "fn decorate(text, prefix) { return(cat(prefix, uppercase(text))) }\n\nTop::\n -> Word {\n   pieces = split(entry_group(0), \"-\")\n   original = { \"a\": pieces[0], \"b\": { \"c\": pieces[1] } }\n   tree = copy(original)\n   seen = []\n   prefix = \"old:\"\n   text = \"outside\"\n   transform = {|text| push(seen, text); return(decorate(text, prefix)) }\n   prefix = \"new:\"\n   result = tree.map_leaves!() { return(transform(value)) }\n   i = 0\n   visited = 0\n   while(i < count(pieces)) { visited = visited + 1; i = i + 1 }\n   tree[\"meta\"][\"count\"] = visited\n   print_each(seen, \"leaf:\", \"!\")\n   say(\"done:\", visited)\n   return({ \"tree\": copy(tree), \"mapped\": result, \"original\": original,\n            \"seen\": seen, \"text\": text, \"visits\": visited })\n }\n\nWord:\n /([A-Za-z]+-[A-Za-z]+)/\n"
    },
    "pipeline.spec": {
      "path": ".linkedspec-data/scratch/selfcontain131/pipeline.spec",
      "sha256": "ba9953c282e5e66956dc4b7d22c2acc7b1e879734654e7cb467ad41275cc4249",
      "text": "fn decorate(text, prefix) { return(cat(prefix, uppercase(text))) }\n\nTop::\n -> Word {\n   if(num_ne(match_start_pos(), 0)) { exit_now(1) }\n   if(num_ne(match_end_pos(), input_end_pos())) { exit_now(1) }\n   pieces = split(match_text(), \"-\")\n   original = { \"a\": pieces[0], \"b\": { \"c\": pieces[1] } }\n   tree = copy(original)\n   seen = []\n   prefix = \"old:\"\n   text = \"outside\"\n   transform = {|text| push(seen, text); return(decorate(text, prefix)) }\n   prefix = \"new:\"\n   result = tree.map_leaves!() { return(transform(value)) }\n   i = 0\n   visited = 0\n   while(i < count(pieces)) { visited = visited + 1; i = i + 1 }\n   tree[\"meta\"][\"count\"] = visited\n   print_each(seen, \"leaf:\", \"!\")\n   say(\"done:\", visited)\n   return({ \"tree\": copy(tree), \"mapped\": result, \"original\": original,\n            \"seen\": seen, \"text\": text, \"visits\": visited })\n }\nLX { exit_now(1) }\n\nWord:\n /([A-Za-z]+-[A-Za-z]+)/\n"
    }
