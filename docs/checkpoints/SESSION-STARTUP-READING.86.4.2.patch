+        ["out = /(14,2)\nreturn(add(out, /(8,2)))", 11],
+        ["rx = /(14,2)\nnext = /; return(7)", 7],
+        ["out = /(count(array(\"/;\", \"b\")),2)\nreturn(out)", 1],
+        ["out = /(count(array(\"/,\", \"b\")),2)\r\nreturn(out)", 1],
