+# SESSION-STARTUP-READING.86.4.2: multiline regex lexical boundaries.
+sub split_statements {
+    return LinkedSpec::ActionIR::StatementSplit::_split_action_ir_statements(
+        $_[0], { trim_action_ir_value => sub {
+            my $text = shift;
+            $text =~ s/^\s+|\s+$//g;
+            return $text;
+        } });
+}
+
+subtest 'multiline regex tokens retain complete statements and scalar spans' => sub {
+    my @patterns = (
+        "(x)\ny", "(14,2)\ntext", "(14,2)\nnext = ", "(x)\r\ny",
+        "(x)\n,tail", "(x)\\/\ny", "(x)\ny;z", "(雪)\ny",
+    );
+    for my $pattern (@patterns) {
+        my $assignment = "rx = /$pattern/";
+        my $source = "  $assignment; note = 7\nreturn(note)";
+        is_deeply(split_statements($source),
+            [$assignment, 'note = 7', 'return(note)'],
+            'only authored statement separators split the source');
+        my $ast = LinkedSpec::ActionIR::AST::parse_action_block($source);
+        is_deeply([map { $_->{source} } @{$ast->{statements}}],
+            [$assignment, 'note = 7', 'return(note)'], 'AST retains exact source');
+        my $first = $ast->{statements}[0];
+        is($first->{source_span}{start}, 2, 'statement starts after the original indent');
+        is($first->{source_span}{end}, 2 + length($assignment), 'statement end uses scalar offsets');
+        is($first->{expr}{value}{kind}, 'regex', 'assignment owns a typed regex');
+        is($first->{expr}{value}{pattern}, $pattern, 'AST retains exact pattern text');
+        my $lowered = LinkedSpec::call_spec_handler_subst('Top', $source);
+        cmp_ok(index($lowered, '$rx = /' . $pattern . '/'), '>=', 0,
+            'lowering retains the full literal');
+        unlike($lowered, qr/num_div|UNSUPPORTED_ACTIONIR_HELPER/, 'literal does not become division');
+    }
+};
+
+subtest 'division newlines and mixed regex sequences keep their statements' => sub {
+    for my $separator ("\n", "\r\n", " \n", '; ') {
+        for my $tail ('note = 1', 'rx = /x/', 'other = /(8,2)',
+                      'other = div(8,2)', 'note = matches("x", /x/)') {
+            my $source = "out = /(14,2)$separator$tail; return(out)";
+            is_deeply(split_statements($source),
+                ['out = /(14,2)', $tail, 'return(out)'], 'division retains following source');
+            my $lowered = LinkedSpec::call_spec_handler_subst('Top', $source);
+            my $run = eval "sub { no strict; $lowered }";
+            is($@, '', 'lowered mixed action compiles');
+            local $_ = 'x';
+            is($run ? $run->() : undef, 7, 'division keeps its numeric result');
+        }
+    }
+};
+
+subtest 'regex semantics survive helper arguments and Perl quote controls' => sub {
+    for my $separator ("\n", "\r\n") {
