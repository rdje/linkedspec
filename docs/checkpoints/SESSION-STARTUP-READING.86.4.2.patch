 sub _looks_like_slash_symbol_call_at {
  my ($text, $idx) = @_;
  return 0 unless defined $text;
@@ -83,6 +109,16 @@ sub _looks_like_slash_symbol_call_at {

    my $after = $pos + 1;
    ++$after while $after < $len && substr($text, $after, 1) =~ /\s/o;
+   if (substr($text, $pos + 1, $after - $pos - 1) =~ /[\r\n]/o) {
+    # A complete multiline literal must extend beyond the balanced call
+    # candidate. A slash inside a quoted call argument is not its terminator.
+    my $literal_end = _slash_literal_end_at($text, $idx);
+    return 0 if defined($literal_end) && $literal_end > $pos + 1;
+    # Keep the existing outer-closing-brace exclusion; its reconciliation is
+    # separate from the ordinary newline between two action statements.
+    return 0 if $after < $len && substr($text, $after, 1) eq '}';
+    return 1;
+   }
    return 1 if $after >= $len || substr($text, $after, 1) =~ /[,;\.\)\]]/o;
    return 0;
   }
