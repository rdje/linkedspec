+# Return the end of a complete slash literal at an expression boundary. Looking
+# only for another slash would steal the opener of a later regex from division
+# followed by a newline (for example, /(14,2) followed by rx = /x/).
+sub _slash_literal_end_at {
+ my ($text, $idx) = @_;
+ return undef unless defined($text) && defined($idx) && $idx >= 0 && $idx < length($text)
+  && substr($text, $idx, 1) eq '/';
+ my $len = length($text);
+ my $cursor = $idx + 1;
+ while ($cursor < $len) {
+  my $char = substr($text, $cursor, 1);
+  if ($char eq '\\') {
+   $cursor += 2;
+   next;
+  }
+  ++$cursor;
+  next unless $char eq '/';
+  ++$cursor while $cursor < $len && substr($text, $cursor, 1) =~ /[A-Za-z]/o;
+  my $end = $cursor;
+  ++$cursor while $cursor < $len && substr($text, $cursor, 1) =~ /[ \t]/o;
+  return $end if $cursor == $len || substr($text, $cursor, 1) =~ /[\r\n,;\.\)\]\}]/o;
+  return undef;
+ }
+ return undef
+}
