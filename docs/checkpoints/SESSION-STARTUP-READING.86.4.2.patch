+        my $source = "note = 7; return(matches(\"x${separator}y\", /$pattern/))";
+        my $lowered = LinkedSpec::call_spec_handler_subst('Top', $source);
+        my $run = eval "sub { no strict; $lowered }";
+        is($@, '', 'lowered matching action compiles');
+        is($run ? $run->() : undef, 1, 'literal newline actually participates in matching');
+    }
+    for my $literal ('qr/a;b/', 'q/a;b/', 'm/a;b/', '/a;b/') {
+        my $source = "rx = $literal; return(7)";
