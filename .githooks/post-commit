#!/usr/bin/env bash
# .githooks/post-commit — verify committed MEMORY.md names the new commit's first-parent activation boundary.
# This is a verification-only recovery signal; it never modifies the commit or working tree.
# Activate once per clone: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

if ! output=$("$ROOT/scripts/check_memory_commit_pointer.sh" \
 --phase post-commit --repo-root "$ROOT" 2>&1); then
 printf '%s\n' "$output" >&2
 printf '%s\n' \
  'post-commit: commit already exists; open a task-tree-owned correction before the next commit' >&2
 exit 0
fi

printf '%s\n' "$output"
